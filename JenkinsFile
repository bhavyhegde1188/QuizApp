pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
        timeout(time: 20, unit: 'MINUTES')
    }

    environment {

        // =====================================================
        // GITHUB
        // =====================================================

        GIT_URL = 'https://github.com/bhavyhegde1188/QuizApp.git'


        // =====================================================
        // JENKINS STORAGE
        // =====================================================

        DEPLOYMENT_DIR = 'C:\\JenkinsStorage'

        QUIZAPP_WAR =
            'C:\\JenkinsStorage\\QuizApp.war'

        APPZILLON_SERVER_WAR =
            'C:\\JenkinsStorage\\AppzillonServer.war'


        // =====================================================
        // BACKEND
        // =====================================================

        BACKEND_PORT = '8020'

        BACKEND_LOG =
            'C:\\JenkinsStorage\\backend.log'

        BACKEND_ERROR_LOG =
            'C:\\JenkinsStorage\\backend-error.log'


        // =====================================================
        // TOMCAT
        // =====================================================

        TOMCAT_HOME =
            'D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53'

        TOMCAT_WEBAPPS =
            'D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53\\webapps'

        TOMCAT_PORT = '8084'


        // =====================================================
        // APPLICATION URLS
        // =====================================================

        BACKEND_URL =
            'http://localhost:8020/api/topics'

        FRONTEND_URL =
            'http://localhost:8084/QuizApp/'

        FRONTEND_PAGE_URL =
            'http://localhost:8084/QuizApp/QuizAp.jsp'
    }


    stages {


        // =====================================================
        // 1. CHECKOUT
        // =====================================================

        stage('Checkout') {

            steps {

                echo '============================================'
                echo 'CHECKOUT QUIZAPP'
                echo '============================================'

                git(
                    branch: 'main',
                    url: "${GIT_URL}"
                )
            }
        }


        // =====================================================
        // 2. CHECK ENVIRONMENT
        // =====================================================

        stage('Check Environment') {

            steps {

                echo '============================================'
                echo 'CHECKING ENVIRONMENT'
                echo '============================================'

                bat '''
                    @echo off

                    echo.
                    echo ==================== JAVA ====================
                    java -version

                    if errorlevel 1 (
                        echo ERROR: Java is not available.
                        exit /b 1
                    )


                    echo.
                    echo ==================== MAVEN ====================
                    mvn -version

                    if errorlevel 1 (
                        echo ERROR: Maven is not available in PATH.
                        exit /b 1
                    )


                    echo.
                    echo ==================== TOMCAT ====================

                    if not exist "%TOMCAT_HOME%" (
                        echo ERROR: Tomcat directory not found.
                        echo %TOMCAT_HOME%
                        exit /b 1
                    )

                    echo Tomcat found.


                    echo.
                    echo ==================== TOMCAT WEBAPPS ====================

                    if not exist "%TOMCAT_WEBAPPS%" (
                        echo ERROR: Tomcat webapps directory not found.
                        echo %TOMCAT_WEBAPPS%
                        exit /b 1
                    )

                    echo Tomcat webapps found.


                    echo.
                    echo ==================== QUIZAPP WAR ====================

                    if not exist "%QUIZAPP_WAR%" (
                        echo ERROR: QuizApp.war not found.
                        echo Expected:
                        echo %QUIZAPP_WAR%
                        exit /b 1
                    )

                    echo QuizApp.war found.


                    echo.
                    echo ==================== APPZILLON SERVER WAR ====================

                    if not exist "%APPZILLON_SERVER_WAR%" (
                        echo ERROR: AppzillonServer.war not found.
                        echo Expected:
                        echo %APPZILLON_SERVER_WAR%
                        exit /b 1
                    )

                    echo AppzillonServer.war found.


                    echo.
                    echo ==================== ENVIRONMENT OK ====================
                '''
            }
        }


        // =====================================================
        // 3. BUILD BACKEND
        // =====================================================

        stage('Build Backend') {

            steps {

                echo '============================================'
                echo 'BUILDING SPRING BOOT BACKEND'
                echo '============================================'

                bat '''
                    @echo off

                    mvn clean package -DskipTests

                    if errorlevel 1 (
                        echo.
                        echo ERROR: Backend build failed.
                        exit /b 1
                    )

                    echo.
                    echo Backend build successful.

                    echo.
                    echo Generated JAR files:

                    dir "%WORKSPACE%\\target\\*.jar"
                '''
            }
        }


        // =====================================================
        // 4. VERIFY BACKEND JAR
        // =====================================================

        stage('Verify Backend JAR') {

            steps {

                echo '============================================'
                echo 'VERIFYING BACKEND JAR'
                echo '============================================'

                bat '''
                    @echo off

                    if not exist "%WORKSPACE%\\target\\*.jar" (
                        echo ERROR: Backend JAR was not generated.
                        exit /b 1
                    )

                    echo Backend JAR generated successfully.

                    dir "%WORKSPACE%\\target\\*.jar"
                '''
            }
        }


        // =====================================================
        // 5. STOP OLD BACKEND
        // =====================================================

        stage('Stop Backend') {

            steps {

                echo '============================================'
                echo 'STOPPING OLD BACKEND'
                echo '============================================'

                powershell '''

                    $connections = Get-NetTCPConnection `
                        -LocalPort 8020 `
                        -State Listen `
                        -ErrorAction SilentlyContinue

                    if ($connections) {

                        foreach ($connection in $connections) {

                            $pid = $connection.OwningProcess

                            Write-Host "Stopping backend PID: $pid"

                            Stop-Process `
                                -Id $pid `
                                -Force `
                                -ErrorAction SilentlyContinue
                        }

                    } else {

                        Write-Host "Backend is not currently running."
                    }

                    Start-Sleep -Seconds 3
                '''
            }
        }


        // =====================================================
        // 6. START BACKEND
        // =====================================================

        stage('Start Backend') {

            steps {

                echo '============================================'
                echo 'STARTING BACKEND :8020'
                echo '============================================'

                powershell '''

                    $jar = Get-ChildItem `
                        "$env:WORKSPACE\\target\\*.jar" |
                        Select-Object -First 1

                    if (-not $jar) {

                        Write-Error "Backend JAR not found."

                        exit 1
                    }

                    Write-Host "Backend JAR:"
                    Write-Host $jar.FullName


                    if (Test-Path "C:\\JenkinsStorage\\backend.log") {

                        Remove-Item `
                            "C:\\JenkinsStorage\\backend.log" `
                            -Force `
                            -ErrorAction SilentlyContinue
                    }


                    if (Test-Path "C:\\JenkinsStorage\\backend-error.log") {

                        Remove-Item `
                            "C:\\JenkinsStorage\\backend-error.log" `
                            -Force `
                            -ErrorAction SilentlyContinue
                    }


                    $env:JENKINS_NODE_COOKIE = "dontKillMe"


                    $process = Start-Process `
                        -FilePath "java" `
                        -ArgumentList "-jar", $jar.FullName, "--server.port=8020" `
                        -WorkingDirectory $env:WORKSPACE `
                        -RedirectStandardOutput "C:\\JenkinsStorage\\backend.log" `
                        -RedirectStandardError "C:\\JenkinsStorage\\backend-error.log" `
                        -PassThru


                    Write-Host "Backend started with PID: $($process.Id)"
                '''
            }
        }


        // =====================================================
        // 7. WAIT FOR BACKEND
        // =====================================================

        stage('Wait For Backend') {

            steps {

                echo '============================================'
                echo 'WAITING FOR BACKEND :8020'
                echo '============================================'

                timeout(time: 90, unit: 'SECONDS') {

                    powershell '''

                        $ready = $false


                        for ($i = 0; $i -lt 18; $i++) {

                            Write-Host "Checking backend..."


                            try {

                                $response = Invoke-WebRequest `
                                    -Uri "http://localhost:8020/api/topics" `
                                    -UseBasicParsing `
                                    -TimeoutSec 5


                                Write-Host "Backend HTTP Status: $($response.StatusCode)"

                                if ($response.StatusCode -eq 200) {

                                    $ready = $true

                                    break
                                }

                            } catch {

                                Write-Host "Backend is not ready yet."
                            }


                            Start-Sleep -Seconds 5
                        }


                        if (-not $ready) {

                            Write-Host ""
                            Write-Host "============================================"
                            Write-Host "BACKEND FAILED TO START"
                            Write-Host "============================================"


                            if (Test-Path "C:\\JenkinsStorage\\backend.log") {

                                Write-Host ""
                                Write-Host "BACKEND LOG:"
                                Get-Content "C:\\JenkinsStorage\\backend.log"
                            }


                            if (Test-Path "C:\\JenkinsStorage\\backend-error.log") {

                                Write-Host ""
                                Write-Host "BACKEND ERROR LOG:"
                                Get-Content "C:\\JenkinsStorage\\backend-error.log"
                            }


                            exit 1
                        }


                        Write-Host ""
                        Write-Host "============================================"
                        Write-Host "BACKEND IS UP ON PORT 8020"
                        Write-Host "============================================"
                    '''
                }
            }
        }


        // =====================================================
        // 8. STOP TOMCAT
        // =====================================================

        stage('Stop Tomcat') {

            steps {

                echo '============================================'
                echo 'STOPPING TOMCAT'
                echo '============================================'

                powershell '''

                    $connections = Get-NetTCPConnection `
                        -LocalPort 8084 `
                        -State Listen `
                        -ErrorAction SilentlyContinue


                    if ($connections) {

                        foreach ($connection in $connections) {

                            $pid = $connection.OwningProcess

                            Write-Host "Stopping Tomcat PID: $pid"

                            Stop-Process `
                                -Id $pid `
                                -Force `
                                -ErrorAction SilentlyContinue
                        }

                    } else {

                        Write-Host "Tomcat is not currently running."
                    }


                    Start-Sleep -Seconds 5
                '''
            }
        }


        // =====================================================
        // 9. CLEAN TOMCAT
        // =====================================================

        stage('Clean Tomcat') {

            steps {

                echo '============================================'
                echo 'CLEANING OLD APPZILLON DEPLOYMENT'
                echo '============================================'

                bat '''
                    @echo off


                    if exist "%TOMCAT_WEBAPPS%\\AppzillonServer.war" (

                        del /F /Q "%TOMCAT_WEBAPPS%\\AppzillonServer.war"
                    )


                    if exist "%TOMCAT_WEBAPPS%\\QuizApp.war" (

                        del /F /Q "%TOMCAT_WEBAPPS%\\QuizApp.war"
                    )


                    if exist "%TOMCAT_WEBAPPS%\\AppzillonServer" (

                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\AppzillonServer"
                    )


                    if exist "%TOMCAT_WEBAPPS%\\QuizApp" (

                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\QuizApp"
                    )


                    echo Old Appzillon deployment cleaned.
                '''
            }
        }


        // =====================================================
        // 10. DEPLOY APPZILLON
        // =====================================================

        stage('Deploy Appzillon') {

            steps {

                echo '============================================'
                echo 'DEPLOYING APPZILLON WAR FILES'
                echo '============================================'

                bat '''
                    @echo off


                    echo.
                    echo Copying AppzillonServer.war...

                    copy /Y ^
                        "%APPZILLON_SERVER_WAR%" ^
                        "%TOMCAT_WEBAPPS%\\AppzillonServer.war"


                    if errorlevel 1 (

                        echo ERROR: AppzillonServer.war copy failed.

                        exit /b 1
                    )


                    echo.
                    echo Copying QuizApp.war...

                    copy /Y ^
                        "%QUIZAPP_WAR%" ^
                        "%TOMCAT_WEBAPPS%\\QuizApp.war"


                    if errorlevel 1 (

                        echo ERROR: QuizApp.war copy failed.

                        exit /b 1
                    }


                    echo.
                    echo ==========================================
                    echo APPZILLON WAR FILES DEPLOYED
                    echo ==========================================


                    echo.
                    echo Tomcat webapps:

                    dir "%TOMCAT_WEBAPPS%" /A
                '''
            }
        }


        // =====================================================
        // 11. START TOMCAT
        // =====================================================

        stage('Start Tomcat') {

            steps {

                echo '============================================'
                echo 'STARTING TOMCAT :8084'
                echo '============================================'

                bat '''
                    @echo off

                    set JENKINS_NODE_COOKIE=dontKillMe

                    cd /d "%TOMCAT_HOME%\\bin"

                    start "Tomcat" /B cmd /c "catalina.bat start"

                    echo.
                    echo Tomcat start command sent.
                '''

                sleep(time: 20, unit: 'SECONDS')
            }
        }


        // =====================================================
        // 12. WAIT FOR TOMCAT
        // =====================================================

        stage('Wait For Tomcat') {

            steps {

                echo '============================================'
                echo 'WAITING FOR TOMCAT :8084'
                echo '============================================'

                timeout(time: 90, unit: 'SECONDS') {

                    powershell '''

                        $ready = $false


                        for ($i = 0; $i -lt 18; $i++) {

                            Write-Host "Checking Tomcat..."


                            $result = Test-NetConnection `
                                -ComputerName "localhost" `
                                -Port 8084 `
                                -WarningAction SilentlyContinue


                            if ($result.TcpTestSucceeded) {

                                Write-Host ""
                                Write-Host "============================================"
                                Write-Host "TOMCAT IS UP ON PORT 8084"
                                Write-Host "============================================"

                                $ready = $true

                                break
                            }


                            Start-Sleep -Seconds 5
                        }


                        if (-not $ready) {

                            Write-Error "Tomcat failed to start."

                            exit 1
                        }
                    '''
                }
            }
        }


        // =====================================================
        // 13. WAIT FOR APPZILLON
        // =====================================================

        stage('Wait For Appzillon') {

            steps {

                echo '============================================'
                echo 'WAITING FOR APPZILLON APPLICATIONS'
                echo '============================================'

                powershell '''

                    Write-Host "Tomcat is running."

                    Write-Host "Waiting for Appzillon applications to initialize..."

                    Start-Sleep -Seconds 25

                    Write-Host ""

                    Write-Host "Appzillon initialization wait completed."
                '''
            }
        }


        // =====================================================
        // 14. VERIFY DEPLOYMENT
        // =====================================================

        stage('Verify Deployment') {

            steps {

                echo '============================================'
                echo 'VERIFYING DEPLOYMENT'
                echo '============================================'

                powershell '''

                    # -------------------------------------------------
                    # BACKEND
                    # -------------------------------------------------

                    Write-Host ""
                    Write-Host "Checking Backend :8020..."


                    $backend = Test-NetConnection `
                        -ComputerName "localhost" `
                        -Port 8020 `
                        -WarningAction SilentlyContinue


                    if (-not $backend.TcpTestSucceeded) {

                        Write-Error "Backend is not running."

                        exit 1
                    }


                    Write-Host "Backend :8020 -> OK"


                    # -------------------------------------------------
                    # TOMCAT
                    # -------------------------------------------------

                    Write-Host ""
                    Write-Host "Checking Tomcat :8084..."


                    $tomcat = Test-NetConnection `
                        -ComputerName "localhost" `
                        -Port 8084 `
                        -WarningAction SilentlyContinue


                    if (-not $tomcat.TcpTestSucceeded) {

                        Write-Error "Tomcat is not running."

                        exit 1
                    }


                    Write-Host "Tomcat :8084 -> OK"


                    # -------------------------------------------------
                    # WAR FILES
                    # -------------------------------------------------

                    Write-Host ""
                    Write-Host "Checking WAR files..."


                    if (-not (Test-Path "$env:TOMCAT_WEBAPPS\\AppzillonServer.war")) {

                        Write-Error "AppzillonServer.war missing."

                        exit 1
                    }


                    if (-not (Test-Path "$env:TOMCAT_WEBAPPS\\QuizApp.war")) {

                        Write-Error "QuizApp.war missing."

                        exit 1
                    }


                    Write-Host "AppzillonServer.war -> OK"

                    Write-Host "QuizApp.war -> OK"


                    # -------------------------------------------------
                    # DEPLOYMENT DIRECTORY
                    # -------------------------------------------------

                    Write-Host ""
                    Write-Host "Checking extracted applications..."


                    if (Test-Path "$env:TOMCAT_WEBAPPS\\AppzillonServer") {

                        Write-Host "AppzillonServer directory -> OK"

                    } else {

                        Write-Error "AppzillonServer was not extracted."

                        exit 1
                    }


                    if (Test-Path "$env:TOMCAT_WEBAPPS\\QuizApp") {

                        Write-Host "QuizApp directory -> OK"

                    } else {

                        Write-Error "QuizApp was not extracted."

                        exit 1
                    }


                    Write-Host ""
                    Write-Host "============================================"
                    Write-Host "TOMCAT DEPLOYMENT CHECK PASSED"
                    Write-Host "============================================"
                '''
            }
        }


        // =====================================================
        // 15. FRONTEND CHECK
        // =====================================================

        stage('Verify Frontend') {

            steps {

                echo '============================================'
                echo 'VERIFYING QUIZAPP FRONTEND'
                echo '============================================'

                powershell '''

                    Write-Host ""
                    Write-Host "Checking QuizApp application..."


                    # First check the actual JSP contained in your WAR.
                    # Your WAR contains QuizAp.jsp.

                    try {

                        $response = Invoke-WebRequest `
                            -Uri "http://localhost:8084/QuizApp/QuizAp.jsp" `
                            -UseBasicParsing `
                            -TimeoutSec 10


                        Write-Host "QuizAp.jsp HTTP Status: $($response.StatusCode)"


                        if ($response.StatusCode -eq 200) {

                            Write-Host ""
                            Write-Host "============================================"
                            Write-Host "QUIZAPP FRONTEND IS UP"
                            Write-Host "============================================"

                            Write-Host ""
                            Write-Host "Frontend:"
                            Write-Host "http://localhost:8084/QuizApp/"

                            Write-Host ""
                            Write-Host "Application page:"
                            Write-Host "http://localhost:8084/QuizApp/QuizAp.jsp"

                            exit 0
                        }

                    } catch {

                        Write-Host "QuizAp.jsp is not ready yet."
                    }


                    # -------------------------------------------------
                    # FALLBACK ROOT CHECK
                    # -------------------------------------------------

                    try {

                        $root = Invoke-WebRequest `
                            -Uri "http://localhost:8084/QuizApp/" `
                            -UseBasicParsing `
                            -TimeoutSec 10


                        Write-Host "QuizApp root HTTP Status: $($root.StatusCode)"


                        if ($root.StatusCode -eq 200) {

                            Write-Host ""
                            Write-Host "QuizApp root is responding."

                            exit 0
                        }

                    } catch {

                        Write-Host "QuizApp root is not responding."
                    }


                    Write-Host ""
                    Write-Host "============================================"
                    Write-Host "QUIZAPP FRONTEND CHECK FAILED"
                    Write-Host "============================================"


                    Write-Host ""
                    Write-Host "Check Tomcat logs:"
                    Write-Host "$env:TOMCAT_HOME\\logs"


                    exit 1
                '''
            }
        }


        // =====================================================
        // 16. FINAL SERVICE CHECK
        // =====================================================

        stage('Final Service Check') {

            steps {

                echo '============================================'
                echo 'FINAL SERVICE CHECK'
                echo '============================================'

                powershell '''

                    $backend = Test-NetConnection `
                        -ComputerName "localhost" `
                        -Port 8020 `
                        -WarningAction SilentlyContinue


                    $tomcat = Test-NetConnection `
                        -ComputerName "localhost" `
                        -Port 8084 `
                        -WarningAction SilentlyContinue


                    if (-not $backend.TcpTestSucceeded) {

                        Write-Error "Backend is down."

                        exit 1
                    }


                    if (-not $tomcat.TcpTestSucceeded) {

                        Write-Error "Tomcat is down."

                        exit 1
                    }


                    Write-Host ""
                    Write-Host "============================================"
                    Write-Host "BACKEND + TOMCAT ARE RUNNING"
                    Write-Host "============================================"


                    Write-Host ""
                    Write-Host "Backend:"
                    Write-Host "http://localhost:8020/api/topics"


                    Write-Host ""
                    Write-Host "Frontend:"
                    Write-Host "http://localhost:8084/QuizApp/"


                    Write-Host ""
                    Write-Host "QuizApp page:"
                    Write-Host "http://localhost:8084/QuizApp/QuizAp.jsp"
                '''
            }
        }
    }


    // =========================================================
    // POST ACTIONS
    // =========================================================

    post {

        success {

            echo '''
============================================
QUIZAPP PIPELINE SUCCESSFUL
============================================

Backend:
http://localhost:8020/api/topics

Frontend:
http://localhost:8084/QuizApp/

QuizApp page:
http://localhost:8084/QuizApp/QuizAp.jsp

QuizApp WAR:
C:\JenkinsStorage\QuizApp.war

AppzillonServer WAR:
C:\JenkinsStorage\AppzillonServer.war

Backend JAR:
Generated inside Jenkins workspace
NOT copied to JenkinsStorage

============================================
'''
        }


        failure {

            echo '''
============================================
QUIZAPP PIPELINE FAILED
============================================

Check the failed stage above.

Tomcat logs:

D:\apache-tomcat-9.0.53-windows-x64\apache-tomcat-9.0.53\logs

Backend log:

C:\JenkinsStorage\backend.log

Backend error log:

C:\JenkinsStorage\backend-error.log

============================================
'''
        }


        always {

            bat '''
                @echo off

                echo.
                echo ==========================================
                echo FINAL STATUS
                echo ==========================================

                echo.
                echo BACKEND PORT 8020:

                powershell -NoProfile -Command "Get-NetTCPConnection -LocalPort 8020 -ErrorAction SilentlyContinue | Format-Table -AutoSize"


                echo.
                echo TOMCAT PORT 8084:

                powershell -NoProfile -Command "Get-NetTCPConnection -LocalPort 8084 -ErrorAction SilentlyContinue | Format-Table -AutoSize"


                echo.
                echo TOMCAT WEBAPPS:

                dir "%TOMCAT_WEBAPPS%" /A
            '''
        }
    }
}