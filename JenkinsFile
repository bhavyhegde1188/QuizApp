pipeline {

    agent any

    environment {

        JAVA_HOME = 'C:/Program Files/Java/jdk-17.0.2'

        DEPLOY_DIR = 'C:/JenkinsStorage'

        JAR_FILE = 'target/quizapp-1.0.0.jar'

        BACKEND_PORT = '8020'

        HEALTH_URL = 'http://localhost:8020/api/topics'

        TOMCAT_HOME = 'D:/apache-tomcat-9.0.53-windows-x64/apache-tomcat-9.0.53'

        TOMCAT_WEBAPPS = 'D:/apache-tomcat-9.0.53-windows-x64/apache-tomcat-9.0.53/webapps'

        FRONTEND_WAR = 'QuizApp.war'

        FRONTEND_CONTEXT = 'QuizApp'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Source code already checked out by Jenkins SCM.'
            }
        }

        stage('Build Backend') {
            steps {
                bat '''
                    echo Checking Java...
                    "%JAVA_HOME%\\bin\\java.exe" -version

                    echo Building Spring Boot application...

                    mvn clean package -DskipTests

                    if not exist "%WORKSPACE%\\target\\quizapp-1.0.0.jar" (
                        echo ERROR: Backend JAR was not created.
                        exit /b 1
                    )

                    echo Backend build successful.
                '''
            }
        }

        stage('Run Tests') {
            steps {
                bat '''
                    echo Running Maven tests...

                    mvn test

                    if errorlevel 1 (
                        echo ERROR: Tests failed.
                        exit /b 1
                    )

                    echo Tests completed successfully.
                '''
            }
        }

        stage('Prepare Deployment') {
            steps {
                bat '''
                    echo Checking deployment directory...

                    if not exist "C:\\JenkinsStorage" (
                        mkdir "C:\\JenkinsStorage"
                    )

                    echo Deployment directory ready.
                '''
            }
        }

        stage('Deploy Backend') {
            steps {
                bat '''
                    echo ==========================================
                    echo DEPLOYING BACKEND
                    echo ==========================================

                    echo Checking existing backend process...

                    for /f "tokens=5" %%a in ('netstat -ano ^| findstr :8020 ^| findstr LISTENING') do (
                        echo Stopping PID %%a
                        taskkill /F /PID %%a >nul 2>&1
                    )

                    ping 127.0.0.1 -n 4 >nul

                    echo Copying JAR...

                    copy /Y ^
                    "%WORKSPACE%\\target\\quizapp-1.0.0.jar" ^
                    "C:\\JenkinsStorage\\quizapp-1.0.0.jar"

                    if errorlevel 1 (
                        echo ERROR: JAR copy failed.
                        exit /b 1
                    )

                    echo JAR copied successfully.

                    if exist "C:\\JenkinsStorage\\backend.log" (
                        del /F /Q "C:\\JenkinsStorage\\backend.log"
                    )

                    echo Starting Spring Boot application...

                    start "QuizApp-Backend" /B cmd /c ^
                    "set JENKINS_NODE_COOKIE=dontKillMe && "%JAVA_HOME%\\bin\\java.exe" -jar "C:\\JenkinsStorage\\quizapp-1.0.0.jar" > "C:\\JenkinsStorage\\backend.log" 2>&1"

                    echo Backend start command executed.
                '''
            }
        }

        stage('Backend Health Check') {
            steps {
                bat '''
                    echo ==========================================
                    echo BACKEND HEALTH CHECK
                    echo ==========================================

                    set RETRIES=30

                    :CHECK_BACKEND

                    curl -s -o nul -w "%%{http_code}" "%HEALTH_URL%" > "%TEMP%\\quiz_backend_status.txt"

                    set /p STATUS=<"%TEMP%\\quiz_backend_status.txt"

                    echo Backend HTTP Status: %STATUS%

                    if "%STATUS%"=="200" (
                        echo BACKEND IS RUNNING.
                        exit /b 0
                    )

                    set /a RETRIES-=1

                    if %RETRIES% LEQ 0 (
                        echo ERROR: Backend health check failed.
                        echo.
                        echo Backend log:
                        echo ------------------------------------------

                        if exist "C:\\JenkinsStorage\\backend.log" (
                            type "C:\\JenkinsStorage\\backend.log"
                        )

                        echo ------------------------------------------
                        exit /b 1
                    )

                    ping 127.0.0.1 -n 3 >nul

                    goto CHECK_BACKEND
                '''
            }
        }

        stage('Deploy Appzillon Frontend') {
            steps {
                bat '''
                    echo ==========================================
                    echo DEPLOYING APPZILLON FRONTEND
                    echo ==========================================

                    if not exist "C:\\JenkinsStorage\\QuizApp.war" (
                        echo ERROR: QuizApp.war not found.
                        exit /b 1
                    )

                    echo QuizApp.war found.

                    echo Stopping Tomcat...

                    call "%TOMCAT_HOME%\\bin\\shutdown.bat"

                    ping 127.0.0.1 -n 8 >nul

                    echo Removing old QuizApp WAR...

                    if exist "%TOMCAT_WEBAPPS%\\QuizApp.war" (
                        del /F /Q "%TOMCAT_WEBAPPS%\\QuizApp.war"
                    )

                    echo Removing old QuizApp directory...

                    if exist "%TOMCAT_WEBAPPS%\\QuizApp" (
                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\QuizApp"
                    )

                    echo Copying new WAR...

                    copy /Y ^
                    "C:\\JenkinsStorage\\QuizApp.war" ^
                    "%TOMCAT_WEBAPPS%\\QuizApp.war"

                    if errorlevel 1 (
                        echo ERROR: WAR copy failed.
                        exit /b 1
                    )

                    echo WAR copied successfully.

                    echo Starting Tomcat...

                    call "%TOMCAT_HOME%\\bin\\startup.bat"

                    echo Waiting for Tomcat...

                    set RETRIES=30

                    :CHECK_TOMCAT

                    netstat -ano | findstr :8084 | findstr LISTENING

                    if not errorlevel 1 (
                        echo TOMCAT IS RUNNING ON PORT 8084.
                        exit /b 0
                    )

                    set /a RETRIES-=1

                    if %RETRIES% LEQ 0 (
                        echo ERROR: Tomcat did not start on port 8084.
                        exit /b 1
                    )

                    ping 127.0.0.1 -n 3 >nul

                    goto CHECK_TOMCAT
                '''
            }
        }

        stage('Frontend Health Check') {
            steps {
                bat '''
                    echo ==========================================
                    echo FRONTEND HEALTH CHECK
                    echo ==========================================

                    curl -I "http://localhost:8084/QuizApp/"

                    if errorlevel 1 (
                        echo ERROR: QuizApp frontend is not accessible.
                        exit /b 1
                    )

                    echo APPZILLON FRONTEND IS RUNNING.
                '''
            }
        }
    }

    post {

        success {
            echo '''
==========================================
QUIZAPP CI/CD SUCCESSFUL
==========================================

Backend:
http://localhost:8020

Frontend:
http://localhost:8084/QuizApp/

Backend JAR:
C:\\JenkinsStorage\\quizapp-1.0.0.jar

Frontend WAR:
C:\\JenkinsStorage\\QuizApp.war

Backend Log:
C:\\JenkinsStorage\\backend.log

==========================================
'''
        }

        failure {
            echo '''
==========================================
QUIZAPP CI/CD FAILED
==========================================

Check the stage where the pipeline stopped.

==========================================
'''
        }
    }
}