pipeline {

    agent any

    environment {

        // ==============================
        // JAVA
        // ==============================

        JAVA_HOME = 'C:/Program Files/Java/jdk-17.0.2'


        // ==============================
        // JENKINS STORAGE
        // ==============================

        DEPLOY_DIR = 'C:/JenkinsStorage'

        JAR_NAME = 'quizapp-1.0.0.jar'

        WEB_WAR = 'QuizApp.war'
        SERVER_WAR = 'AppzillonServer.war'


        // ==============================
        // BACKEND
        // ==============================

        BACKEND_PORT = '8020'

        BACKEND_URL = 'http://localhost:8020/api/topics'


        // ==============================
        // TOMCAT
        // ==============================

        TOMCAT_HOME =
            'D:/apache-tomcat-9.0.53-windows-x64/apache-tomcat-9.0.53'

        TOMCAT_WEBAPPS =
            'D:/apache-tomcat-9.0.53-windows-x64/apache-tomcat-9.0.53/webapps'

        TOMCAT_PORT = '8084'


        // ==============================
        // APPZILLON
        // ==============================

        WEB_CONTEXT = 'QuizApp'

        SERVER_CONTEXT = 'AppzillonServer'

        FRONTEND_URL = 'http://localhost:8084/QuizApp'
    }


    stages {


        // ============================================================
        // CHECKOUT
        // ============================================================

        stage('Checkout') {

            steps {

                echo '=========================================='
                echo 'CHECKOUT'
                echo '=========================================='

                echo 'GitHub source code checked out by Jenkins SCM.'
            }
        }


        // ============================================================
        // BUILD BACKEND
        // ============================================================

        stage('Build Backend') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo BUILDING SPRING BOOT BACKEND
                    echo ==========================================

                    set "PATH=%JAVA_HOME%\\bin;%PATH%"

                    echo.
                    echo Java Version:
                    java -version

                    echo.
                    echo Running Maven build...

                    call mvn clean package -DskipTests

                    if errorlevel 1 (
                        echo.
                        echo ERROR: Maven build failed.
                        exit /b 1
                    )

                    echo.
                    echo Maven build successful.

                    if not exist "%WORKSPACE%\\target\\%JAR_NAME%" (
                        echo.
                        echo ERROR: Backend JAR was not created.
                        echo Expected:
                        echo %WORKSPACE%\\target\\%JAR_NAME%
                        exit /b 1
                    )

                    echo.
                    echo Backend JAR found successfully:

                    dir "%WORKSPACE%\\target\\%JAR_NAME%"
                '''
            }
        }


        // ============================================================
        // RUN TESTS
        // ============================================================

        stage('Run Tests') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo RUNNING TESTS
                    echo ==========================================

                    call mvn test

                    if errorlevel 1 (
                        echo.
                        echo ERROR: Tests failed.
                        exit /b 1
                    )

                    echo.
                    echo Tests completed successfully.
                '''
            }
        }


        // ============================================================
        // VERIFY WAR FILES
        // ============================================================

        stage('Verify Deployment Files') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo VERIFYING DEPLOYMENT FILES
                    echo ==========================================

                    echo.
                    echo Checking QuizApp.war...

                    if not exist "%DEPLOY_DIR%\\%WEB_WAR%" (
                        echo.
                        echo ERROR: QuizApp.war not found.
                        echo Expected:
                        echo %DEPLOY_DIR%\\%WEB_WAR%
                        exit /b 1
                    )

                    echo QuizApp.war found.

                    dir "%DEPLOY_DIR%\\%WEB_WAR%"


                    echo.
                    echo Checking AppzillonServer.war...

                    if not exist "%DEPLOY_DIR%\\%SERVER_WAR%" (
                        echo.
                        echo ERROR: AppzillonServer.war not found.
                        echo Expected:
                        echo %DEPLOY_DIR%\\%SERVER_WAR%
                        exit /b 1
                    )

                    echo AppzillonServer.war found.

                    dir "%DEPLOY_DIR%\\%SERVER_WAR%"


                    echo.
                    echo Both WAR files are available.
                '''
            }
        }


        // ============================================================
        // COPY BACKEND JAR
        // ============================================================

        stage('Copy Backend JAR') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo COPYING BACKEND JAR
                    echo ==========================================

                    copy /Y ^
                    "%WORKSPACE%\\target\\%JAR_NAME%" ^
                    "%DEPLOY_DIR%\\%JAR_NAME%"

                    if errorlevel 1 (
                        echo.
                        echo ERROR: Failed to copy backend JAR.
                        exit /b 1
                    )

                    echo.
                    echo Backend JAR copied successfully.

                    dir "%DEPLOY_DIR%\\%JAR_NAME%"
                '''
            }
        }


        // ============================================================
        // DEPLOY BACKEND
        // ============================================================

        stage('Deploy Backend') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo DEPLOYING SPRING BOOT BACKEND
                    echo ==========================================

                    echo.
                    echo Checking backend port %BACKEND_PORT%...

                    for /f "tokens=5" %%a in (
                        'netstat -ano ^| findstr :%BACKEND_PORT% ^| findstr LISTENING'
                    ) do (
                        echo Stopping old backend PID %%a
                        taskkill /F /PID %%a >nul 2>&1
                    )

                    echo.
                    echo Waiting for old backend to stop...

                    ping 127.0.0.1 -n 4 >nul


                    echo.
                    echo Removing old backend log...

                    if exist "%DEPLOY_DIR%\\backend.log" (
                        del /F /Q "%DEPLOY_DIR%\\backend.log"
                    )


                    echo.
                    echo Starting Spring Boot backend...

                    set "PATH=%JAVA_HOME%\\bin;%PATH%"

                    set "JENKINS_NODE_COOKIE=dontKillMe"


                    start "QuizApp-Backend" /B cmd /c ^
                    "set JENKINS_NODE_COOKIE=dontKillMe && "%JAVA_HOME%\\bin\\java.exe" -jar "%DEPLOY_DIR%\\%JAR_NAME%" > "%DEPLOY_DIR%\\backend.log" 2>&1"


                    echo.
                    echo Backend start command executed.
                '''
            }
        }


        // ============================================================
        // BACKEND HEALTH CHECK
        // ============================================================

        stage('Backend Health Check') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo BACKEND HEALTH CHECK
                    echo ==========================================

                    echo.
                    echo Backend URL:
                    echo %BACKEND_URL%

                    set RETRIES=30


                    :BACKEND_CHECK


                    curl -s -o nul -w "%%{http_code}" ^
                    "%BACKEND_URL%" > "%TEMP%\\backend_status.txt"


                    set /p STATUS=<"%TEMP%\\backend_status.txt"


                    echo Backend HTTP Status: %STATUS%


                    if "%STATUS%"=="200" (

                        echo.
                        echo ==========================================
                        echo BACKEND IS RUNNING
                        echo ==========================================

                        exit /b 0
                    )


                    set /a RETRIES-=1


                    if %RETRIES% LEQ 0 (

                        echo.
                        echo ==========================================
                        echo ERROR: BACKEND FAILED TO START
                        echo ==========================================

                        echo.
                        echo Backend URL:
                        echo %BACKEND_URL%


                        echo.
                        echo Backend log:

                        if exist "%DEPLOY_DIR%\\backend.log" (
                            powershell -Command "Get-Content '%DEPLOY_DIR%\\backend.log' -Tail 100"
                        )

                        exit /b 1
                    )


                    echo Backend is not ready.

                    echo Waiting 3 seconds...

                    ping 127.0.0.1 -n 4 >nul

                    goto BACKEND_CHECK
                '''
            }
        }


        // ============================================================
        // DEPLOY APPZILLON WAR FILES
        // ============================================================

        stage('Deploy Appzillon WARs') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo DEPLOYING APPZILLON WAR FILES
                    echo ==========================================


                    echo.
                    echo Checking QuizApp.war...

                    if not exist "%DEPLOY_DIR%\\%WEB_WAR%" (
                        echo ERROR: QuizApp.war not found.
                        exit /b 1
                    )


                    echo.
                    echo Checking AppzillonServer.war...

                    if not exist "%DEPLOY_DIR%\\%SERVER_WAR%" (
                        echo ERROR: AppzillonServer.war not found.
                        exit /b 1
                    )


                    echo.
                    echo Checking Tomcat installation...

                    if not exist "%TOMCAT_HOME%\\bin\\catalina.bat" (

                        echo ERROR: catalina.bat not found.

                        echo Expected:
                        echo %TOMCAT_HOME%\\bin\\catalina.bat

                        exit /b 1
                    )

                    echo Tomcat installation found.


                    // ------------------------------------------------
                    // STOP TOMCAT
                    // ------------------------------------------------

                    echo.
                    echo ==========================================
                    echo STOPPING EXISTING TOMCAT
                    echo ==========================================


                    for /f "tokens=5" %%a in (
                        'netstat -ano ^| findstr :%TOMCAT_PORT% ^| findstr LISTENING'
                    ) do (

                        echo Stopping Tomcat PID %%a

                        taskkill /F /PID %%a >nul 2>&1
                    )


                    echo.
                    echo Waiting for Tomcat to stop...

                    ping 127.0.0.1 -n 6 >nul


                    // ------------------------------------------------
                    // REMOVE OLD QUIZAPP
                    // ------------------------------------------------

                    echo.
                    echo ==========================================
                    echo REMOVING OLD QUIZAPP DEPLOYMENT
                    echo ==========================================


                    if exist "%TOMCAT_WEBAPPS%\\%WEB_CONTEXT%" (

                        echo Removing old QuizApp directory...

                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\%WEB_CONTEXT%"
                    )


                    if exist "%TOMCAT_WEBAPPS%\\%WEB_WAR%" (

                        echo Removing old QuizApp WAR...

                        del /F /Q "%TOMCAT_WEBAPPS%\\%WEB_WAR%"
                    )


                    // ------------------------------------------------
                    // REMOVE OLD SERVER
                    // ------------------------------------------------

                    echo.
                    echo ==========================================
                    echo REMOVING OLD APPZILLON SERVER
                    echo ==========================================


                    if exist "%TOMCAT_WEBAPPS%\\%SERVER_CONTEXT%" (

                        echo Removing old AppzillonServer directory...

                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\%SERVER_CONTEXT%"
                    )


                    if exist "%TOMCAT_WEBAPPS%\\%SERVER_WAR%" (

                        echo Removing old AppzillonServer WAR...

                        del /F /Q "%TOMCAT_WEBAPPS%\\%SERVER_WAR%"
                    )


                    // ------------------------------------------------
                    // COPY QUIZAPP WAR
                    // ------------------------------------------------

                    echo.
                    echo ==========================================
                    echo COPYING QUIZAPP WAR
                    echo ==========================================


                    copy /Y ^
                    "%DEPLOY_DIR%\\%WEB_WAR%" ^
                    "%TOMCAT_WEBAPPS%\\%WEB_WAR%"


                    if errorlevel 1 (

                        echo ERROR: Failed to copy QuizApp.war.

                        exit /b 1
                    )


                    echo QuizApp.war copied successfully.


                    // ------------------------------------------------
                    // COPY SERVER WAR
                    // ------------------------------------------------

                    echo.
                    echo ==========================================
                    echo COPYING APPZILLON SERVER WAR
                    echo ==========================================


                    copy /Y ^
                    "%DEPLOY_DIR%\\%SERVER_WAR%" ^
                    "%TOMCAT_WEBAPPS%\\%SERVER_WAR%"


                    if errorlevel 1 (

                        echo ERROR: Failed to copy AppzillonServer.war.

                        exit /b 1
                    )


                    echo AppzillonServer.war copied successfully.


                    // ------------------------------------------------
                    // START TOMCAT
                    // ------------------------------------------------

                    echo.
                    echo ==========================================
                    echo STARTING TOMCAT
                    echo ==========================================


                    set "JAVA_HOME=C:\\Program Files\\Java\\jdk-17.0.2"

                    set "CATALINA_HOME=%TOMCAT_HOME%"

                    set "PATH=%JAVA_HOME%\\bin;%PATH%"

                    set "JENKINS_NODE_COOKIE=dontKillMe"


                    if exist "%TOMCAT_HOME%\\logs\\jenkins-run.log" (

                        del /F /Q "%TOMCAT_HOME%\\logs\\jenkins-run.log"
                    )


                    start "QuizApp-Tomcat" /B cmd /c ^
                    "set JENKINS_NODE_COOKIE=dontKillMe && call "%TOMCAT_HOME%\\bin\\catalina.bat" run > "%TOMCAT_HOME%\\logs\\jenkins-run.log" 2>&1"


                    echo.
                    echo Tomcat start command executed.


                    echo.
                    echo Waiting 15 seconds for Tomcat startup...


                    ping 127.0.0.1 -n 16 >nul
                '''
            }
        }


        // ============================================================
        // TOMCAT HEALTH CHECK
        // ============================================================

        stage('Tomcat Health Check') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo TOMCAT HEALTH CHECK
                    echo ==========================================

                    echo.
                    echo Checking port %TOMCAT_PORT%...


                    set RETRIES=30


                    :TOMCAT_CHECK


                    netstat -ano | findstr :%TOMCAT_PORT% | findstr LISTENING


                    if not errorlevel 1 (

                        echo.
                        echo ==========================================
                        echo TOMCAT IS RUNNING
                        echo ==========================================

                        exit /b 0
                    )


                    set /a RETRIES-=1


                    if %RETRIES% LEQ 0 (

                        echo.
                        echo ==========================================
                        echo ERROR: TOMCAT FAILED TO START
                        echo ==========================================


                        echo.
                        echo Tomcat log:


                        if exist "%TOMCAT_HOME%\\logs\\jenkins-run.log" (

                            powershell -Command "Get-Content '%TOMCAT_HOME%\\logs\\jenkins-run.log' -Tail 150"
                        )


                        exit /b 1
                    )


                    echo Tomcat is not ready.

                    echo Waiting 3 seconds...

                    ping 127.0.0.1 -n 4 >nul

                    goto TOMCAT_CHECK
                '''
            }
        }


        // ============================================================
        // VERIFY APPZILLON DEPLOYMENT
        // ============================================================

        stage('Verify Appzillon Deployment') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo VERIFYING APPZILLON DEPLOYMENT
                    echo ==========================================


                    echo.
                    echo Checking QuizApp.war...


                    if not exist "%TOMCAT_WEBAPPS%\\%WEB_WAR%" (

                        echo ERROR: QuizApp.war is missing from Tomcat webapps.

                        exit /b 1
                    )


                    echo QuizApp.war is present.


                    echo.
                    echo Checking AppzillonServer.war...


                    if not exist "%TOMCAT_WEBAPPS%\\%SERVER_WAR%" (

                        echo ERROR: AppzillonServer.war is missing from Tomcat webapps.

                        exit /b 1
                    )


                    echo AppzillonServer.war is present.


                    echo.
                    echo Waiting for QuizApp to deploy...


                    set RETRIES=30


                    :CHECK_QUIZAPP


                    if exist "%TOMCAT_WEBAPPS%\\%WEB_CONTEXT%" (

                        echo.
                        echo ==========================================
                        echo QUIZAPP DEPLOYED SUCCESSFULLY
                        echo ==========================================

                        echo.
                        echo QuizApp directory:

                        echo %TOMCAT_WEBAPPS%\\%WEB_CONTEXT%

                        exit /b 0
                    )


                    echo QuizApp directory does not exist yet.

                    echo Waiting 5 seconds...


                    set /a RETRIES-=1


                    if %RETRIES% LEQ 0 (

                        echo.
                        echo ==========================================
                        echo ERROR: QUIZAPP FAILED TO DEPLOY
                        echo ==========================================


                        echo.
                        echo QuizApp WAR:

                        dir "%TOMCAT_WEBAPPS%\\%WEB_WAR%"


                        echo.
                        echo ==========================================
                        echo TOMCAT DEPLOYMENT LOG
                        echo ==========================================


                        if exist "%TOMCAT_HOME%\\logs\\jenkins-run.log" (

                            powershell -Command "Get-Content '%TOMCAT_HOME%\\logs\\jenkins-run.log' -Tail 200"
                        )


                        echo.
                        echo ==========================================
                        echo CATALINA LOG
                        echo ==========================================


                        for /f "delims=" %%F in (
                            'dir /b /o-d "%TOMCAT_HOME%\\logs\\catalina.*.log" 2^>nul'
                        ) do (

                            powershell -Command "Get-Content '%TOMCAT_HOME%\\logs\\%%F' -Tail 100"

                            goto CATALINA_LOG_DONE
                        )


                        :CATALINA_LOG_DONE

                        exit /b 1
                    )


                    ping 127.0.0.1 -n 6 >nul

                    goto CHECK_QUIZAPP
                '''
            }
        }


        // ============================================================
        // FRONTEND HEALTH CHECK
        // ============================================================

        stage('Frontend Health Check') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo APPZILLON FRONTEND HEALTH CHECK
                    echo ==========================================


                    echo.
                    echo Frontend URL:

                    echo %FRONTEND_URL%


                    set RETRIES=20


                    :FRONTEND_CHECK


                    curl -s -o nul -w "%%{http_code}" ^
                    "%FRONTEND_URL%" > "%TEMP%\\frontend_status.txt"


                    set /p STATUS=<"%TEMP%\\frontend_status.txt"


                    echo Frontend HTTP Status: %STATUS%


                    if "%STATUS%"=="200" (

                        echo.
                        echo ==========================================
                        echo APPZILLON FRONTEND IS UP
                        echo ==========================================

                        exit /b 0
                    )


                    if "%STATUS%"=="302" (

                        echo.
                        echo ==========================================
                        echo APPZILLON FRONTEND IS UP
                        echo ==========================================

                        exit /b 0
                    )


                    set /a RETRIES-=1


                    if %RETRIES% LEQ 0 (

                        echo.
                        echo ==========================================
                        echo ERROR: APPZILLON FRONTEND IS NOT UP
                        echo ==========================================


                        echo.
                        echo Frontend URL:

                        echo %FRONTEND_URL%


                        echo.
                        echo HTTP Status:

                        echo %STATUS%


                        echo.
                        echo ==========================================
                        echo TOMCAT LOG
                        echo ==========================================


                        if exist "%TOMCAT_HOME%\\logs\\jenkins-run.log" (

                            powershell -Command "Get-Content '%TOMCAT_HOME%\\logs\\jenkins-run.log' -Tail 150"
                        )


                        exit /b 1
                    }


                    echo Frontend is not ready.

                    echo Waiting 5 seconds...

                    ping 127.0.0.1 -n 6 >nul

                    goto FRONTEND_CHECK
                '''
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        success {

            echo '''
==========================================
QUIZAPP CI/CD SUCCESSFUL
==========================================

Backend:
http://localhost:8020/api/topics

Frontend:
http://localhost:8084/QuizApp

Backend JAR:
C:\\JenkinsStorage\\quizapp-1.0.0.jar

QuizApp WAR:
C:\\JenkinsStorage\\QuizApp.war

AppzillonServer WAR:
C:\\JenkinsStorage\\AppzillonServer.war

Backend Log:
C:\\JenkinsStorage\\backend.log

Tomcat Log:
D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53\\logs\\jenkins-run.log

==========================================
'''
        }


        failure {

            echo '''
==========================================
QUIZAPP CI/CD FAILED
==========================================

Check the failed stage above.

If Tomcat deployment fails, check:

D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53\\logs\\jenkins-run.log

==========================================
'''
        }
    }
}