pipeline {

    agent any

    environment {

        JAVA_HOME = 'C:/Program Files/Java/jdk-17.0.2'

        JAR_FILE = 'target/quizapp-1.0.0.jar'

        DEPLOY_DIR = 'C:/JenkinsStorage'

        BACKEND_PORT = '8020'

        HEALTH_URL = 'http://localhost:8020/api/topics'

        TOMCAT_HOME =
            'D:/apache-tomcat-9.0.53-windows-x64/apache-tomcat-9.0.53'

        TOMCAT_WEBAPPS =
            'D:/apache-tomcat-9.0.53-windows-x64/apache-tomcat-9.0.53/webapps'

        FRONTEND_WAR = 'QuizApp.war'

        FRONTEND_CONTEXT = 'QuizApp'
    }

    stages {

        stage('Build Backend') {

            steps {

                bat '''
                    "%JAVA_HOME%\\bin\\java.exe" -version

                    mvn clean package -DskipTests

                    dir "%WORKSPACE%\\target\\*.jar"

                    if not exist "%WORKSPACE%\\target\\quizapp-1.0.0.jar" (
                        echo ERROR: quizapp-1.0.0.jar was not created.
                        exit /b 1
                    )

                    echo Backend build successful.
                '''
            }
        }

        stage('Run Tests') {

            steps {

                bat '''
                    mvn test
                '''
            }
        }

        stage('Deploy Backend') {

            steps {

                bat '''

                    echo Checking port 8020...

                    for /f "tokens=5" %%a in ('netstat -ano ^| findstr :8020 ^| findstr LISTENING') do (
                        echo Stopping process %%a...
                        taskkill /F /PID %%a >nul 2>&1
                    )

                    ping 127.0.0.1 -n 4 >nul

                    if not exist "C:\\JenkinsStorage" (
                        mkdir "C:\\JenkinsStorage"
                    )

                    if not exist "%WORKSPACE%\\target\\quizapp-1.0.0.jar" (
                        echo ERROR: JAR not found.
                        exit /b 1
                    )

                    copy /Y ^
                    "%WORKSPACE%\\target\\quizapp-1.0.0.jar" ^
                    "C:\\JenkinsStorage\\quizapp-1.0.0.jar"

                    if errorlevel 1 (
                        echo ERROR: Failed to copy JAR.
                        exit /b 1
                    )

                    cd /d "C:\\JenkinsStorage"

                    start "QuizApp-Backend" /B cmd /c ^
                    "set JENKINS_NODE_COOKIE=dontKillMe && "%JAVA_HOME%\\bin\\java.exe" -jar "C:\\JenkinsStorage\\quizapp-1.0.0.jar" > "C:\\JenkinsStorage\\backend.log" 2>&1"

                    echo Backend started.

                '''
            }
        }

        stage('Backend Health Check') {

            steps {

                bat '''

                    echo Waiting for backend...

                    set RETRIES=30

                    :CHECK_BACKEND

                    curl -s -o nul -w "%%{http_code}" "%HEALTH_URL%" > "%TEMP%\\quiz_health.txt"

                    set /p STATUS=<"%TEMP%\\quiz_health.txt"

                    echo HTTP Status: %STATUS%

                    if "%STATUS%"=="200" (
                        echo BACKEND IS RUNNING
                        exit /b 0
                    )

                    if "%STATUS%"=="201" (
                        echo BACKEND IS RUNNING
                        exit /b 0
                    )

                    if "%STATUS%"=="204" (
                        echo BACKEND IS RUNNING
                        exit /b 0
                    )

                    set /a RETRIES-=1

                    if %RETRIES% LEQ 0 (

                        echo BACKEND HEALTH CHECK FAILED

                        echo.
                        echo Backend log:
                        echo.

                        if exist "C:\\JenkinsStorage\\backend.log" (
                            type "C:\\JenkinsStorage\\backend.log"
                        )

                        exit /b 1
                    )

                    ping 127.0.0.1 -n 3 >nul

                    goto CHECK_BACKEND

                '''
            }
        }

        stage('Deploy Appzillon Frontend') {

            steps {

                bat '''

                    echo Checking Appzillon WAR...

                    if not exist "C:\\JenkinsStorage\\QuizApp.war" (
                        echo ERROR: QuizApp.war not found in C:\\JenkinsStorage
                        exit /b 1
                    )

                    echo WAR found.

                    echo Stopping Tomcat...

                    call "%TOMCAT_HOME%\\bin\\shutdown.bat"

                    ping 127.0.0.1 -n 6 >nul

                    echo Removing old WAR...

                    if exist "%TOMCAT_WEBAPPS%\\QuizApp.war" (
                        del /F /Q "%TOMCAT_WEBAPPS%\\QuizApp.war"
                    )

                    echo Removing old application folder...

                    if exist "%TOMCAT_WEBAPPS%\\QuizApp" (
                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\QuizApp"
                    )

                    echo Copying Appzillon WAR...

                    copy /Y ^
                    "C:\\JenkinsStorage\\QuizApp.war" ^
                    "%TOMCAT_WEBAPPS%\\QuizApp.war"

                    if errorlevel 1 (
                        echo ERROR: Failed to copy Appzillon WAR.
                        exit /b 1
                    )

                    echo WAR deployed successfully.

                    echo Starting Tomcat...

                    call "%TOMCAT_HOME%\\bin\\startup.bat"

                    echo Tomcat started.

                    ping 127.0.0.1 -n 15 >nul

                '''
            }
        }

        stage('Frontend Health Check') {

            steps {

                bat '''

                    echo Checking Appzillon frontend...

                    curl -I "http://localhost:8084/QuizApp/"

                    if errorlevel 1 (
                        echo FRONTEND HEALTH CHECK FAILED
                        exit /b 1
                    )

                    echo APPZILLON FRONTEND IS RUNNING.

                '''
            }
        }
    }

    post {

        success {

            echo '''
==================================================
QUIZAPP CI/CD PIPELINE SUCCESSFUL
==================================================

Backend:
http://localhost:8020

Frontend:
http://localhost:8084/QuizApp/

Backend JAR:
C:\\JenkinsStorage\\quizapp-1.0.0.jar

Frontend WAR:
C:\\JenkinsStorage\\QuizApp.war

Backend Log:
C:\\JenkinsStorage\\backend.log

==================================================
'''
        }

        failure {

            echo '''
==================================================
QUIZAPP CI/CD PIPELINE FAILED
==================================================

Check the Jenkins Console Output.

==================================================
'''
        }
    }
}