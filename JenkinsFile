pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
        timeout(time: 10, unit: 'MINUTES')
    }

    parameters {
        string(name: 'GIT_REPOSITORY', defaultValue: 'https://github.com/bhavyhegde1188/QuizApp.git', description: 'Git repository URL')
        string(name: 'GIT_BRANCH', defaultValue: 'main', description: 'Git branch')
        string(name: 'BACKEND_DEPLOY_DIR', defaultValue: 'C:\\JenkinsStorage\\QuizApp', description: 'Required backend deployment directory')
        string(name: 'SOURCE_JAR', defaultValue: 'target\\quizapp-1.0.0.jar', description: 'Built backend JAR path')
        string(name: 'BACKEND_JAR_NAME', defaultValue: 'quizapp.jar', description: 'Deployed backend JAR filename')
        string(name: 'BACKEND_PROCESS_NAME', defaultValue: 'QuizAppBackend', description: 'Backend process window name')
        string(name: 'BACKEND_LOG_NAME', defaultValue: 'backend.log', description: 'Backend standard output log filename')
        string(name: 'BACKEND_ERROR_LOG_NAME', defaultValue: 'backend-error.log', description: 'Backend error log filename')
        string(name: 'BACKEND_PORT', defaultValue: '8020', description: 'Backend port')
        string(name: 'BACKEND_HEALTH_URL', defaultValue: 'http://localhost:8020/api/topics', description: 'Backend health URL')
        string(name: 'WAR_ONE_SOURCE', defaultValue: 'C:\\JenkinsStorage\\QuizApp.war', description: 'First WAR source path')
        string(name: 'WAR_ONE_NAME', defaultValue: 'QuizApp.war', description: 'First WAR name in Tomcat webapps')
        string(name: 'WAR_TWO_SOURCE', defaultValue: 'C:\\JenkinsStorage\\AppzillonServer.war', description: 'Second WAR source path')
        string(name: 'WAR_TWO_NAME', defaultValue: 'AppzillonServer.war', description: 'Second WAR name in Tomcat webapps')
        string(name: 'FRONTEND_CONTEXT', defaultValue: 'QuizApp', description: 'Frontend Tomcat context')
        string(name: 'FRONTEND_URL', defaultValue: 'http://localhost:8084/QuizApp', description: 'Frontend URL')
        string(name: 'E2E_PROFILE', defaultValue: 'e2e', description: 'Maven profile for browser tests')
        string(name: 'PLAYWRIGHT_BROWSER', defaultValue: 'chromium', description: 'Playwright browser to install')
        string(name: 'E2E_REPORT_DIR', defaultValue: 'target\\failsafe-reports', description: 'E2E report directory')
        string(name: 'TOMCAT_HOME', defaultValue: 'D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53', description: 'Tomcat installation directory')
        string(name: 'TOMCAT_WEBAPPS', defaultValue: 'D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53\\webapps', description: 'Tomcat webapps directory')
        string(name: 'TOMCAT_PORT', defaultValue: '8084', description: 'Tomcat HTTP port')
    }

    environment {
        SOURCE_JAR = "${params.SOURCE_JAR}"
        BACKEND_JAR_NAME = "${params.BACKEND_JAR_NAME}"
        BACKEND_PROCESS_NAME = "${params.BACKEND_PROCESS_NAME}"
        BACKEND_PORT = "${params.BACKEND_PORT}"
        BACKEND_HEALTH_URL = "${params.BACKEND_HEALTH_URL}"
        WAR_ONE_SOURCE = "${params.WAR_ONE_SOURCE}"
        WAR_ONE_NAME = "${params.WAR_ONE_NAME}"
        WAR_TWO_SOURCE = "${params.WAR_TWO_SOURCE}"
        WAR_TWO_NAME = "${params.WAR_TWO_NAME}"
        FRONTEND_CONTEXT = "${params.FRONTEND_CONTEXT}"
        FRONTEND_URL = "${params.FRONTEND_URL}"
        E2E_PROFILE = "${params.E2E_PROFILE}"
        PLAYWRIGHT_BROWSER = "${params.PLAYWRIGHT_BROWSER}"
        E2E_REPORT_DIR = "${params.E2E_REPORT_DIR}"
        BACKEND_DIR = "${params.BACKEND_DEPLOY_DIR}"
        BACKEND_JAR = "${params.BACKEND_DEPLOY_DIR}\\${params.BACKEND_JAR_NAME}"
        BACKEND_LOG = "${params.BACKEND_DEPLOY_DIR}\\${params.BACKEND_LOG_NAME}"
        BACKEND_ERROR_LOG = "${params.BACKEND_DEPLOY_DIR}\\${params.BACKEND_ERROR_LOG_NAME}"
        TOMCAT_HOME = "${params.TOMCAT_HOME}"
        TOMCAT_WEBAPPS = "${params.TOMCAT_WEBAPPS}"
        TOMCAT_PORT = "${params.TOMCAT_PORT}"
    }

    stages {

        stage('Checkout') {
            steps {
                git(branch: "${params.GIT_BRANCH}", url: "${params.GIT_REPOSITORY}")
            }
        }

        stage('Check Environment') {
            
            steps {
                bat '''
                    java -version
                    mvn -version
                    if "%BACKEND_DIR%"=="" (
                        echo ERROR: BACKEND_DEPLOY_DIR is required.
                        exit /b 1
                    )
                    if not exist "%BACKEND_DIR%" mkdir "%BACKEND_DIR%"
                    if not exist "%WAR_ONE_SOURCE%" (
                        echo ERROR: First WAR was not found: %WAR_ONE_SOURCE%
                        exit /b 1
                    )
                    if not exist "%WAR_TWO_SOURCE%" (
                        echo ERROR: Second WAR was not found: %WAR_TWO_SOURCE%
                        exit /b 1
                    )
                    if not exist "%TOMCAT_HOME%\\bin\\startup.bat" (
                        echo ERROR: Tomcat startup script was not found.
                        exit /b 1
                    )
                    if not exist "%TOMCAT_HOME%\\bin\\shutdown.bat" (
                        echo ERROR: Tomcat shutdown script was not found.
                        exit /b 1
                    )
                '''
            }
        }

        stage('Build') {
            steps {
                bat '''
                    call mvn clean test
                    call mvn package -DskipTests
                '''
            }
        }

        stage('Check Backend JAR') {
            steps {
                bat '''
                    if not exist "%SOURCE_JAR%" (
                        echo ERROR: Backend JAR was not generated: %SOURCE_JAR%
                        dir target
                        exit /b 1
                    )
                    dir "%SOURCE_JAR%"
                '''
            }
        }

        stage('Stop Backend') {
            steps {
                powershell '''
                    $port = [int]$env:BACKEND_PORT
                    $connections = Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue
                    foreach ($connection in $connections) {
                        Stop-Process -Id $connection.OwningProcess -Force -ErrorAction SilentlyContinue
                    }
                    Start-Sleep -Seconds 5
                '''
            }
        }

        stage('Deploy Backend') {
            steps {
                bat '''
                    if "%BACKEND_DIR%"=="" (
                        echo ERROR: BACKEND_DEPLOY_DIR is required.
                        exit /b 1
                    )
                    if not exist "%BACKEND_DIR%" mkdir "%BACKEND_DIR%"
                    if not exist "%BACKEND_DIR%" exit /b 1
                    if not exist "%SOURCE_JAR%" (
                        echo ERROR: Backend JAR was not generated: %SOURCE_JAR%
                        exit /b 1
                    )
                    copy /Y "%SOURCE_JAR%" "%BACKEND_JAR%"
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Start Backend') {
            steps {
                powershell '''
                    $port = [int]$env:BACKEND_PORT
                    $connections = Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue
                    foreach ($connection in $connections) {
                        Stop-Process -Id $connection.OwningProcess -Force -ErrorAction SilentlyContinue
                    }

                    $env:JENKINS_NODE_COOKIE = "dontKillMe"
                    $env:BUILD_ID = "dontKillMe"
                    $command = "start `"$env:BACKEND_PROCESS_NAME`" /b java.exe -jar `"$env:BACKEND_JAR`" 1>>`"$env:BACKEND_LOG`" 2>>`"$env:BACKEND_ERROR_LOG`""
                    Start-Process -FilePath "cmd.exe" -ArgumentList "/c", $command -WorkingDirectory $env:BACKEND_DIR -WindowStyle Hidden
                '''
            }
        }

        stage('Verify Backend') {
            when {
                expression { params.BACKEND_HEALTH_URL?.trim() }
            }
            steps {
                powershell '''
                    $response = Invoke-WebRequest -Uri $env:BACKEND_HEALTH_URL -UseBasicParsing -TimeoutSec 20
                    if ($response.StatusCode -lt 200 -or $response.StatusCode -ge 400) { exit 1 }
                '''
            }
        }

        stage('Stop Tomcat') {
            steps {
                bat '''
                    call "%TOMCAT_HOME%\\bin\\shutdown.bat" >nul 2>&1 || echo Tomcat was not running; continuing.
                    powershell.exe -NoProfile -Command "Start-Sleep -Seconds 10"
                '''
            }
        }

        stage('Clean Frontend') {
            steps {
                bat '''
                    if exist "%TOMCAT_WEBAPPS%\\%WAR_ONE_NAME%" del /F /Q "%TOMCAT_WEBAPPS%\\%WAR_ONE_NAME%"
                    if exist "%TOMCAT_WEBAPPS%\\%WAR_TWO_NAME%" del /F /Q "%TOMCAT_WEBAPPS%\\%WAR_TWO_NAME%"
                    if exist "%TOMCAT_WEBAPPS%\\%FRONTEND_CONTEXT%" rmdir /S /Q "%TOMCAT_WEBAPPS%\\%FRONTEND_CONTEXT%"
                '''
            }
        }

        stage('Deploy Frontend') {
            steps {
                bat '''
                    call "%TOMCAT_HOME%\\bin\\shutdown.bat" >nul 2>&1 || echo Tomcat was not running; continuing.
                    powershell.exe -NoProfile -Command "Start-Sleep -Seconds 10"

                    if exist "%TOMCAT_WEBAPPS%\\%WAR_ONE_NAME%" del /F /Q "%TOMCAT_WEBAPPS%\\%WAR_ONE_NAME%"
                    if exist "%TOMCAT_WEBAPPS%\\%WAR_TWO_NAME%" del /F /Q "%TOMCAT_WEBAPPS%\\%WAR_TWO_NAME%"
                    if exist "%TOMCAT_WEBAPPS%\\%FRONTEND_CONTEXT%" rmdir /S /Q "%TOMCAT_WEBAPPS%\\%FRONTEND_CONTEXT%"

                    copy /Y "%WAR_ONE_SOURCE%" "%TOMCAT_WEBAPPS%\\%WAR_ONE_NAME%"
                    if errorlevel 1 exit /b 1
                    copy /Y "%WAR_TWO_SOURCE%" "%TOMCAT_WEBAPPS%\\%WAR_TWO_NAME%"
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        stage('Start Tomcat') {
            steps {
                bat '''
                    set "JENKINS_NODE_COOKIE=dontKillMe"
                    call "%TOMCAT_HOME%\\bin\\startup.bat"
                '''
            }
        }

        stage('Wait For Tomcat') {
            steps {
                timeout(time: 90, unit: 'SECONDS') {
                    powershell '''
                        $ready = $false
                        for ($attempt = 1; $attempt -le 18; $attempt++) {
                            $result = Test-NetConnection -ComputerName localhost -Port ([int]$env:TOMCAT_PORT) -WarningAction SilentlyContinue
                            if ($result.TcpTestSucceeded) { $ready = $true; break }
                            Start-Sleep -Seconds 5
                        }
                        if (-not $ready) { exit 1 }
                    '''
                }
            }
        }

        stage('Wait For Frontend') {
            steps {
                powershell '''
                    Start-Sleep -Seconds 20
                '''
            }
        }

        stage('Run E2E Tests') {
            steps {
                bat '''
                    call mvn exec:java -Dexec.mainClass=com.microsoft.playwright.CLI -Dexec.args="install %PLAYWRIGHT_BROWSER%"
                    if errorlevel 1 exit /b 1
                    call mvn -P%E2E_PROFILE% verify -Dfrontend.url=%FRONTEND_URL%
                    if errorlevel 1 exit /b 1
                    if not exist "%E2E_REPORT_DIR%" (
                        echo ERROR: E2E report directory was not generated.
                        exit /b 1
                    )
                '''
            }
        }

        stage('Verify Frontend Deployment') {
            steps {
                bat '''
                    if not exist "%TOMCAT_WEBAPPS%\\%WAR_ONE_NAME%" exit /b 1
                    if not exist "%TOMCAT_WEBAPPS%\\%WAR_TWO_NAME%" exit /b 1
                '''
            }
        }

        stage('Verify Frontend HTTP') {
            steps {
                powershell '''
                    $ready = $false
                    for ($attempt = 1; $attempt -le 12; $attempt++) {
                        try {
                            $response = Invoke-WebRequest -Uri $env:FRONTEND_URL -UseBasicParsing -TimeoutSec 10
                            if ($response.StatusCode -ge 200 -and $response.StatusCode -lt 400) {
                                $ready = $true
                                break
                            }
                        } catch {
                            Write-Host "Frontend is not ready: $($_.Exception.Message)"
                        }
                        Start-Sleep -Seconds 10
                    }
                    if (-not $ready) { exit 1 }
                '''
            }
        }

        stage('Final Service Check') {
            steps {
                powershell '''
                    $backend = Test-NetConnection localhost -Port ([int]$env:BACKEND_PORT) -WarningAction SilentlyContinue
                    $tomcat = Test-NetConnection localhost -Port ([int]$env:TOMCAT_PORT) -WarningAction SilentlyContinue
                    if (-not $backend.TcpTestSucceeded) { exit 1 }
                    if (-not $tomcat.TcpTestSucceeded) { exit 1 }
                '''
            }
        }

    }

    post {
        success {
            echo 'Generic deployment completed successfully.'
        }
        failure {
            echo 'Generic deployment failed. Check backend and Tomcat logs.'
        }
    }
}
