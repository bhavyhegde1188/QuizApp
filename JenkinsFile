pipeline {

    agent any

    environment {

        JAVA_HOME = 'C:/Program Files/Java/jdk-17.0.2'

        MAVEN_HOME = 'C:/Program Files/apache-maven-3.9.6'

        DEPLOY_DIR = 'C:/JenkinsStorage'

        WEB_WAR = 'QuizApp.war'

        SERVER_WAR = 'AppzillonServer.war'

        BACKEND_PORT = '8020'

        BACKEND_URL = 'http://localhost:8020/api/topics'

        TOMCAT_HOME = 'D:/apache-tomcat-9.0.53-windows-x64/apache-tomcat-9.0.53'

        TOMCAT_WEBAPPS = 'D:/apache-tomcat-9.0.53-windows-x64/apache-tomcat-9.0.53/webapps'

        TOMCAT_PORT = '8084'

        WEB_CONTEXT = 'QuizApp'

        SERVER_CONTEXT = 'AppzillonServer'

        FRONTEND_URL = 'http://localhost:8084/QuizApp/'
    }


    stages {


        stage('Checkout') {

            steps {

                echo 'GitHub source code checked out by Jenkins SCM.'
            }
        }


        stage('Build Backend') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo BUILDING SPRING BOOT BACKEND
                    echo ==========================================

                    echo.
                    echo Java version:

                    "%JAVA_HOME%\\bin\\java.exe" -version

                    echo.
                    echo Maven version:

                    "%MAVEN_HOME%\\bin\\mvn.cmd" -version

                    echo.
                    echo Running Maven build...

                    call "%MAVEN_HOME%\\bin\\mvn.cmd" clean package -DskipTests

                    if errorlevel 1 (
                        echo.
                        echo ERROR: Maven build failed.
                        exit /b 1
                    )

                    echo.
                    echo ==========================================
                    echo BACKEND BUILD SUCCESSFUL
                    echo ==========================================

                    echo.
                    echo Generated JAR files:

                    dir "%WORKSPACE%\\target\\*.jar"
                '''
            }
        }


        stage('Run Tests') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo RUNNING TESTS
                    echo ==========================================

                    call "%MAVEN_HOME%\\bin\\mvn.cmd" test

                    if errorlevel 1 (
                        echo.
                        echo ERROR: Maven tests failed.
                        exit /b 1
                    )

                    echo.
                    echo Tests passed successfully.
                '''
            }
        }


        stage('Verify Deployment Files') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo VERIFYING DEPLOYMENT FILES
                    echo ==========================================

                    if not exist "%DEPLOY_DIR%\\%WEB_WAR%" (
                        echo.
                        echo ERROR: Web WAR not found:
                        echo %DEPLOY_DIR%\\%WEB_WAR%
                        exit /b 1
                    )

                    if not exist "%DEPLOY_DIR%\\%SERVER_WAR%" (
                        echo.
                        echo ERROR: Server WAR not found:
                        echo %DEPLOY_DIR%\\%SERVER_WAR%
                        exit /b 1
                    )

                    echo.
                    echo QuizApp WAR:

                    dir "%DEPLOY_DIR%\\%WEB_WAR%"

                    echo.
                    echo Appzillon Server WAR:

                    dir "%DEPLOY_DIR%\\%SERVER_WAR%"

                    echo.
                    echo Deployment WAR files verified.
                '''
            }
        }


        stage('Deploy Backend') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo DEPLOYING BACKEND
                    echo ==========================================

                    set "BACKEND_JAR="

                    for %%F in ("%WORKSPACE%\\target\\*.jar") do (
                        set "BACKEND_JAR=%%~fF"
                        goto JAR_FOUND
                    )

                    echo.
                    echo ERROR: Backend JAR was not generated.
                    exit /b 1

                    :JAR_FOUND

                    echo.
                    echo Backend JAR:
                    echo %BACKEND_JAR%

                    echo.
                    echo Stopping existing backend...

                    powershell -NoProfile -ExecutionPolicy Bypass -Command ^
                    "$c=Get-NetTCPConnection -LocalPort %BACKEND_PORT% -State Listen -ErrorAction SilentlyContinue; if($c){$c | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object {Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue}}"

                    timeout /t 3 /nobreak >nul

                    if exist "%WORKSPACE%\\backend.log" (
                        del /F /Q "%WORKSPACE%\\backend.log"
                    )

                    echo.
                    echo Starting backend on port %BACKEND_PORT%...

                    start "QuizApp-Backend" /B cmd /c ^
                    ""%JAVA_HOME%\\bin\\java.exe" -jar "%BACKEND_JAR%" --server.port=%BACKEND_PORT% > "%WORKSPACE%\\backend.log" 2>&1"

                    echo.
                    echo Backend start command executed.
                '''
            }
        }


        stage('Backend Health Check') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo BACKEND HEALTH CHECK
                    echo ==========================================

                    set RETRIES=30

                    :BACKEND_CHECK

                    powershell -NoProfile -ExecutionPolicy Bypass -Command ^
                    "try {$r=Invoke-WebRequest -Uri '%BACKEND_URL%' -UseBasicParsing -TimeoutSec 5; Write-Host ('Backend HTTP Status: ' + $r.StatusCode); if($r.StatusCode -eq 200){exit 0}else{exit 1}} catch {Write-Host 'Backend is not ready yet.'; exit 1}"

                    if not errorlevel 1 (
                        echo.
                        echo BACKEND IS RUNNING.
                        echo URL: %BACKEND_URL%
                        exit /b 0
                    )

                    set /a RETRIES-=1

                    if %RETRIES% LEQ 0 (

                        echo.
                        echo ERROR: Backend failed to start.

                        echo.
                        echo ==========================================
                        echo BACKEND LOG
                        echo ==========================================

                        if exist "%WORKSPACE%\\backend.log" (
                            type "%WORKSPACE%\\backend.log"
                        )

                        exit /b 1
                    )

                    echo Waiting 5 seconds...

                    timeout /t 5 /nobreak >nul

                    goto BACKEND_CHECK
                '''
            }
        }


        stage('Deploy Appzillon WARs') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo DEPLOYING APPZILLON WAR FILES
                    echo ==========================================

                    if not exist "%DEPLOY_DIR%\\%WEB_WAR%" (
                        echo ERROR: %WEB_WAR% not found.
                        exit /b 1
                    )

                    if not exist "%DEPLOY_DIR%\\%SERVER_WAR%" (
                        echo ERROR: %SERVER_WAR% not found.
                        exit /b 1
                    )

                    echo.
                    echo Stopping Tomcat...

                    powershell -NoProfile -ExecutionPolicy Bypass -Command ^
                    "$c=Get-NetTCPConnection -LocalPort %TOMCAT_PORT% -State Listen -ErrorAction SilentlyContinue; if($c){$c | Select-Object -ExpandProperty OwningProcess -Unique | ForEach-Object {Stop-Process -Id $_ -Force -ErrorAction SilentlyContinue}}"

                    timeout /t 5 /nobreak >nul

                    echo.
                    echo Removing old QuizApp deployment...

                    if exist "%TOMCAT_WEBAPPS%\\%WEB_WAR%" (
                        del /F /Q "%TOMCAT_WEBAPPS%\\%WEB_WAR%"
                    )

                    if exist "%TOMCAT_WEBAPPS%\\%WEB_CONTEXT%" (
                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\%WEB_CONTEXT%"
                    )

                    echo.
                    echo Removing old AppzillonServer deployment...

                    if exist "%TOMCAT_WEBAPPS%\\%SERVER_WAR%" (
                        del /F /Q "%TOMCAT_WEBAPPS%\\%SERVER_WAR%"
                    )

                    if exist "%TOMCAT_WEBAPPS%\\%SERVER_CONTEXT%" (
                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\%SERVER_CONTEXT%"
                    )

                    echo.
                    echo Copying QuizApp WAR...

                    copy /Y "%DEPLOY_DIR%\\%WEB_WAR%" "%TOMCAT_WEBAPPS%\\%WEB_WAR%"

                    if errorlevel 1 (
                        echo ERROR: QuizApp WAR deployment failed.
                        exit /b 1
                    )

                    echo QuizApp WAR copied successfully.

                    echo.
                    echo Copying AppzillonServer WAR...

                    copy /Y "%DEPLOY_DIR%\\%SERVER_WAR%" "%TOMCAT_WEBAPPS%\\%SERVER_WAR%"

                    if errorlevel 1 (
                        echo ERROR: AppzillonServer WAR deployment failed.
                        exit /b 1
                    )

                    echo AppzillonServer WAR copied successfully.

                    echo.
                    echo Starting Tomcat...

                    cd /d "%TOMCAT_HOME%\\bin"

                    start "Tomcat" /B cmd /c "catalina.bat start"

                    echo.
                    echo Tomcat start command executed.
                '''
            }
        }


        stage('Tomcat Health Check') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo TOMCAT HEALTH CHECK
                    echo ==========================================

                    set RETRIES=30

                    :TOMCAT_CHECK

                    powershell -NoProfile -ExecutionPolicy Bypass -Command ^
                    "$c=Get-NetTCPConnection -LocalPort %TOMCAT_PORT% -State Listen -ErrorAction SilentlyContinue; if($c){Write-Host 'Tomcat is listening on port %TOMCAT_PORT%'; exit 0}else{Write-Host 'Tomcat is not ready yet.'; exit 1}"

                    if not errorlevel 1 (
                        echo.
                        echo TOMCAT IS RUNNING ON PORT %TOMCAT_PORT%.
                        exit /b 0
                    )

                    set /a RETRIES-=1

                    if %RETRIES% LEQ 0 (

                        echo.
                        echo ERROR: Tomcat did not start.

                        echo.
                        echo Check Tomcat logs:

                        echo %TOMCAT_HOME%\\logs

                        exit /b 1
                    )

                    echo Waiting 5 seconds...

                    timeout /t 5 /nobreak >nul

                    goto TOMCAT_CHECK
                '''
            }
        }


        stage('Verify Appzillon Deployment') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo VERIFYING APPZILLON DEPLOYMENT
                    echo ==========================================

                    set RETRIES=30

                    :APPZILLON_CHECK

                    if exist "%TOMCAT_WEBAPPS%\\%SERVER_CONTEXT%" (
                        echo AppzillonServer directory detected.
                        exit /b 0
                    )

                    if exist "%TOMCAT_WEBAPPS%\\%SERVER_WAR%" (
                        echo AppzillonServer WAR detected.
                        exit /b 0
                    )

                    set /a RETRIES-=1

                    if %RETRIES% LEQ 0 (
                        echo.
                        echo ERROR: AppzillonServer deployment not detected.
                        exit /b 1
                    )

                    echo Waiting for Appzillon deployment...

                    timeout /t 5 /nobreak >nul

                    goto APPZILLON_CHECK
                '''
            }
        }


        stage('Frontend Health Check') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo APPZILLON FRONTEND HEALTH CHECK
                    echo ==========================================

                    echo.
                    echo URL:
                    echo %FRONTEND_URL%

                    set RETRIES=30

                    :FRONTEND_CHECK

                    powershell -NoProfile -ExecutionPolicy Bypass -Command ^
                    "try {$r=Invoke-WebRequest -Uri '%FRONTEND_URL%' -UseBasicParsing -TimeoutSec 5; Write-Host ('Frontend HTTP Status: ' + $r.StatusCode); if(($r.StatusCode -eq 200) -or ($r.StatusCode -eq 302) -or ($r.StatusCode -eq 403)){exit 0}else{exit 1}} catch {Write-Host 'QuizApp frontend is not ready yet.'; exit 1}"

                    if not errorlevel 1 (
                        echo.
                        echo ==========================================
                        echo APPZILLON FRONTEND IS RUNNING
                        echo ==========================================
                        echo.
                        echo URL:
                        echo %FRONTEND_URL%
                        exit /b 0
                    )

                    set /a RETRIES-=1

                    if %RETRIES% LEQ 0 (

                        echo.
                        echo ==========================================
                        echo FRONTEND HEALTH CHECK FAILED
                        echo ==========================================

                        echo.
                        echo QuizApp URL:
                        echo %FRONTEND_URL%

                        echo.
                        echo Check Tomcat logs:

                        echo %TOMCAT_HOME%\\logs

                        exit /b 1
                    )

                    echo Waiting 5 seconds...

                    timeout /t 5 /nobreak >nul

                    goto FRONTEND_CHECK
                '''
            }
        }
    }


    post {

        success {

            echo '''
==========================================
QUIZAPP CI/CD SUCCESSFUL
==========================================

Backend:
http://localhost:8020/api/topics

Appzillon Web:
http://localhost:8084/QuizApp/

QuizApp WAR:
C:\\JenkinsStorage\\QuizApp.war

Appzillon Server WAR:
C:\\JenkinsStorage\\AppzillonServer.war

Backend JAR:
Generated in Jenkins workspace

Backend Log:
Jenkins workspace\\backend.log

==========================================
'''
        }


        failure {

            echo '''
==========================================
QUIZAPP CI/CD FAILED
==========================================

Check the failed stage in the Jenkins
Console Output.

If the failure is during frontend
deployment, check:

D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53\\logs

Backend log:

Jenkins workspace\\backend.log

==========================================
'''
        }
    }
}