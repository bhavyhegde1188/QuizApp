pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
        timeout(time: 25, unit: 'MINUTES')
    }

    environment {

        // =====================================================
        // GITHUB
        // =====================================================

        GIT_URL = 'https://github.com/bhavyhegde1188/QuizApp.git'


        // =====================================================
        // JENKINS STORAGE
        // =====================================================

        STORAGE_DIR = 'C:\\JenkinsStorage'

        QUIZAPP_WAR =
            'C:\\JenkinsStorage\\QuizApp.war'

        APPZILLON_SERVER_WAR =
            'C:\\JenkinsStorage\\AppzillonServer.war'

        BACKEND_DEPLOY_DIR =
            'C:\\JenkinsStorage'

        BACKEND_DEPLOY_JAR =
            'C:\\JenkinsStorage\\quizapp-1.0.0.jar'

        BACKEND_LOG =
            'C:\\JenkinsStorage\\backend.log'

        BACKEND_ERROR_LOG =
            'C:\\JenkinsStorage\\backend-error.log'


        // =====================================================
        // BACKEND
        // =====================================================

        BACKEND_PORT = '8020'

        BACKEND_URL =
            'http://localhost:8020/api/topics'


        // =====================================================
        // TOMCAT
        // =====================================================

        TOMCAT_HOME =
            'D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53'

        TOMCAT_WEBAPPS =
            'D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53\\webapps'

        TOMCAT_PORT = '8084'


        // =====================================================
        // FRONTEND
        // =====================================================

        FRONTEND_URL =
            'http://localhost:8084/QuizApp/'

        FRONTEND_PAGE_URL =
            'http://localhost:8084/QuizApp/QuizAp.jsp'
    }


    stages {


        // =====================================================
        // 1. CHECKOUT
        // =====================================================

        stage('Checkout') {

            steps {

                echo '============================================'
                echo 'CHECKOUT QUIZAPP'
                echo '============================================'

                git(
                    branch: 'main',
                    url: "${GIT_URL}"
                )
            }
        }


        // =====================================================
        // 2. CHECK ENVIRONMENT
        // =====================================================

        stage('Check Environment') {

            steps {

                echo '============================================'
                echo 'CHECKING ENVIRONMENT'
                echo '============================================'

                bat '''
                    @echo off

                    echo.
                    echo ================= JAVA =================

                    java -version

                    if errorlevel 1 (
                        echo ERROR: Java is not available.
                        exit /b 1
                    )


                    echo.
                    echo ================= MAVEN =================

                    mvn -version

                    if errorlevel 1 (
                        echo ERROR: Maven is not available.
                        exit /b 1
                    )


                    echo.
                    echo ================= STORAGE =================

                    if not exist "%STORAGE_DIR%" (
                        echo Creating JenkinsStorage directory...
                        mkdir "%STORAGE_DIR%"
                    )

                    echo JenkinsStorage:
                    echo %STORAGE_DIR%


                    echo.
                    echo ================= TOMCAT =================

                    if not exist "%TOMCAT_HOME%" (
                        echo ERROR: Tomcat not found:
                        echo %TOMCAT_HOME%
                        exit /b 1
                    )

                    echo Tomcat found.


                    if not exist "%TOMCAT_WEBAPPS%" (
                        echo ERROR: Tomcat webapps directory not found:
                        echo %TOMCAT_WEBAPPS%
                        exit /b 1
                    )

                    echo Tomcat webapps found.


                    echo.
                    echo ================= QUIZAPP WAR =================

                    if not exist "%QUIZAPP_WAR%" (
                        echo ERROR: QuizApp.war not found:
                        echo %QUIZAPP_WAR%
                        exit /b 1
                    )

                    echo QuizApp.war found.


                    echo.
                    echo ============ APPZILLON SERVER WAR ============

                    if not exist "%APPZILLON_SERVER_WAR%" (
                        echo ERROR: AppzillonServer.war not found:
                        echo %APPZILLON_SERVER_WAR%
                        exit /b 1
                    )

                    echo AppzillonServer.war found.


                    echo.
                    echo ============================================
                    echo ENVIRONMENT CHECK SUCCESSFUL
                    echo ============================================
                '''
            }
        }


        // =====================================================
        // 3. BUILD BACKEND
        // =====================================================

        stage('Build Backend') {

            steps {

                echo '============================================'
                echo 'BUILDING SPRING BOOT BACKEND'
                echo '============================================'

                bat '''
                    @echo off

                    mvn clean package -DskipTests

                    if errorlevel 1 (
                        echo.
                        echo ERROR: Maven build failed.
                        exit /b 1
                    )

                    echo.
                    echo ============================================
                    echo BACKEND BUILD SUCCESSFUL
                    echo ============================================

                    echo.
                    echo Generated JAR:

                    dir "%WORKSPACE%\\target\\*.jar"
                '''
            }
        }


        // =====================================================
        // 4. RUN TESTS
        // =====================================================

        stage('Run Tests') {

            steps {

                echo '============================================'
                echo 'RUNNING BACKEND TESTS'
                echo '============================================'

                bat '''
                    @echo off

                    mvn test

                    if errorlevel 1 (
                        echo.
                        echo ERROR: Tests failed.
                        exit /b 1
                    )

                    echo.
                    echo Tests completed successfully.
                '''
            }
        }


        // =====================================================
        // 5. COPY BACKEND JAR TO JENKINS STORAGE
        // =====================================================

        stage('Deploy Backend JAR') {

            steps {

                echo '============================================'
                echo 'COPYING BACKEND JAR'
                echo '============================================'

                bat '''
                    @echo off

                    echo.
                    echo Searching for Spring Boot JAR...


                    if not exist "%WORKSPACE%\\target\\quizapp-1.0.0.jar" (

                        echo ERROR: Expected backend JAR not found:

                        echo %WORKSPACE%\\target\\quizapp-1.0.0.jar

                        echo.

                        echo Available JAR files:

                        dir "%WORKSPACE%\\target\\*.jar"

                        exit /b 1
                    }


                    echo.
                    echo Copying backend JAR...


                    copy /Y ^
                        "%WORKSPACE%\\target\\quizapp-1.0.0.jar" ^
                        "%BACKEND_DEPLOY_JAR%"


                    if errorlevel 1 (

                        echo ERROR: Backend JAR copy failed.

                        exit /b 1
                    }


                    echo.
                    echo ============================================
                    echo BACKEND JAR COPIED SUCCESSFULLY
                    echo ============================================


                    echo.
                    echo Backend JAR:

                    dir "%BACKEND_DEPLOY_JAR%"
                '''
            }
        }


        // =====================================================
        // 6. STOP OLD BACKEND
        // =====================================================

        stage('Stop Backend') {

            steps {

                echo '============================================'
                echo 'STOPPING OLD BACKEND'
                echo '============================================'

                powershell '''

                    $connections = Get-NetTCPConnection `
                        -LocalPort 8020 `
                        -State Listen `
                        -ErrorAction SilentlyContinue


                    if ($connections) {

                        foreach ($connection in $connections) {

                            $processId =
                                $connection.OwningProcess

                            Write-Host ""
                            Write-Host "Stopping backend PID: $processId"


                            Stop-Process `
                                -Id $processId `
                                -Force `
                                -ErrorAction SilentlyContinue
                        }

                    } else {

                        Write-Host "Backend is not currently running."
                    }


                    Start-Sleep -Seconds 5
                '''
            }
        }


        // =====================================================
        // 7. START BACKEND FROM JENKINS STORAGE
        // =====================================================

        stage('Start Backend') {

            steps {

                echo '============================================'
                echo 'STARTING BACKEND'
                echo '============================================'

                powershell '''

                    if (-not (Test-Path $env:BACKEND_DEPLOY_JAR)) {

                        Write-Error "Backend JAR does not exist."

                        Write-Host $env:BACKEND_DEPLOY_JAR

                        exit 1
                    }


                    Write-Host ""
                    Write-Host "Backend JAR:"
                    Write-Host $env:BACKEND_DEPLOY_JAR


                    if (Test-Path $env:BACKEND_LOG) {

                        Remove-Item `
                            $env:BACKEND_LOG `
                            -Force `
                            -ErrorAction SilentlyContinue
                    }


                    if (Test-Path $env:BACKEND_ERROR_LOG) {

                        Remove-Item `
                            $env:BACKEND_ERROR_LOG `
                            -Force `
                            -ErrorAction SilentlyContinue
                    }


                    Write-Host ""
                    Write-Host "Starting Spring Boot..."


                    $process = Start-Process `
                        -FilePath "java.exe" `
                        -ArgumentList @(
                            "-jar",
                            $env:BACKEND_DEPLOY_JAR,
                            "--server.port=8020"
                        ) `
                        -WorkingDirectory $env:BACKEND_DEPLOY_DIR `
                        -RedirectStandardOutput $env:BACKEND_LOG `
                        -RedirectStandardError $env:BACKEND_ERROR_LOG `
                        -PassThru


                    Write-Host ""
                    Write-Host "Backend process started."
                    Write-Host "PID: $($process.Id)"


                    Start-Sleep -Seconds 5


                    $running = Get-Process `
                        -Id $process.Id `
                        -ErrorAction SilentlyContinue


                    if (-not $running) {

                        Write-Host ""
                        Write-Host "============================================"
                        Write-Host "BACKEND PROCESS EXITED"
                        Write-Host "============================================"


                        Write-Host ""
                        Write-Host "========== BACKEND LOG =========="


                        if (Test-Path $env:BACKEND_LOG) {

                            Get-Content $env:BACKEND_LOG
                        }


                        Write-Host ""
                        Write-Host "========== BACKEND ERROR LOG =========="


                        if (Test-Path $env:BACKEND_ERROR_LOG) {

                            Get-Content $env:BACKEND_ERROR_LOG
                        }


                        exit 1
                    }


                    Write-Host ""
                    Write-Host "Backend process is running."
                '''
            }
        }


        // =====================================================
        // 8. BACKEND HEALTH CHECK
        // =====================================================

        stage('Backend Health Check') {

            steps {

                echo '============================================'
                echo 'CHECKING BACKEND'
                echo '============================================'

                timeout(time: 2, unit: 'MINUTES') {

                    powershell '''

                        $ready = $false


                        for ($i = 0; $i -lt 24; $i++) {

                            Write-Host ""
                            Write-Host "Checking backend attempt $($i + 1)..."


                            try {

                                $response = Invoke-WebRequest `
                                    -Uri $env:BACKEND_URL `
                                    -UseBasicParsing `
                                    -TimeoutSec 10


                                Write-Host "HTTP Status: $($response.StatusCode)"


                                if ($response.StatusCode -eq 200) {

                                    $ready = $true

                                    break
                                }

                            } catch {

                                Write-Host "Backend is not ready yet."
                            }


                            Start-Sleep -Seconds 5
                        }


                        if (-not $ready) {

                            Write-Host ""
                            Write-Host "============================================"
                            Write-Host "BACKEND HEALTH CHECK FAILED"
                            Write-Host "============================================"


                            Write-Host ""
                            Write-Host "========== BACKEND LOG =========="


                            if (Test-Path $env:BACKEND_LOG) {

                                Get-Content `
                                    $env:BACKEND_LOG `
                                    -Tail 200
                            }


                            Write-Host ""
                            Write-Host "========== BACKEND ERROR LOG =========="


                            if (Test-Path $env:BACKEND_ERROR_LOG) {

                                Get-Content `
                                    $env:BACKEND_ERROR_LOG `
                                    -Tail 200
                            }


                            exit 1
                        }


                        Write-Host ""
                        Write-Host "============================================"
                        Write-Host "BACKEND IS UP"
                        Write-Host "============================================"

                        Write-Host ""
                        Write-Host $env:BACKEND_URL
                    '''
                }
            }
        }


        // =====================================================
        // 9. STOP TOMCAT
        // =====================================================

        stage('Stop Tomcat') {

            steps {

                echo '============================================'
                echo 'STOPPING TOMCAT'
                echo '============================================'

                powershell '''

                    $connections = Get-NetTCPConnection `
                        -LocalPort 8084 `
                        -State Listen `
                        -ErrorAction SilentlyContinue


                    if ($connections) {

                        foreach ($connection in $connections) {

                            $processId =
                                $connection.OwningProcess


                            Write-Host ""
                            Write-Host "Stopping Tomcat PID: $processId"


                            Stop-Process `
                                -Id $processId `
                                -Force `
                                -ErrorAction SilentlyContinue
                        }

                    } else {

                        Write-Host "Tomcat is not currently running."
                    }


                    Start-Sleep -Seconds 5
                '''
            }
        }


        // =====================================================
        // 10. CLEAN OLD TOMCAT DEPLOYMENT
        // =====================================================

        stage('Clean Old Deployment') {

            steps {

                echo '============================================'
                echo 'CLEANING OLD TOMCAT DEPLOYMENT'
                echo '============================================'

                bat '''
                    @echo off


                    echo Removing old QuizApp WAR...

                    if exist "%TOMCAT_WEBAPPS%\\QuizApp.war" (
                        del /F /Q "%TOMCAT_WEBAPPS%\\QuizApp.war"
                    )


                    echo Removing old QuizApp directory...

                    if exist "%TOMCAT_WEBAPPS%\\QuizApp" (
                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\QuizApp"
                    )


                    echo Removing old AppzillonServer WAR...

                    if exist "%TOMCAT_WEBAPPS%\\AppzillonServer.war" (
                        del /F /Q "%TOMCAT_WEBAPPS%\\AppzillonServer.war"
                    )


                    echo Removing old AppzillonServer directory...

                    if exist "%TOMCAT_WEBAPPS%\\AppzillonServer" (
                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\AppzillonServer"
                    )


                    echo.
                    echo Old deployment cleaned.
                '''
            }
        }


        // =====================================================
        // 11. COPY APPZILLON WAR FILES
        // =====================================================

        stage('Deploy Appzillon WARs') {

            steps {

                echo '============================================'
                echo 'DEPLOYING APPZILLON WAR FILES'
                echo '============================================'

                bat '''
                    @echo off


                    echo.
                    echo Copying AppzillonServer.war...


                    copy /Y ^
                        "%APPZILLON_SERVER_WAR%" ^
                        "%TOMCAT_WEBAPPS%\\AppzillonServer.war"


                    if errorlevel 1 (

                        echo ERROR: AppzillonServer.war copy failed.

                        exit /b 1
                    }


                    echo.
                    echo Copying QuizApp.war...


                    copy /Y ^
                        "%QUIZAPP_WAR%" ^
                        "%TOMCAT_WEBAPPS%\\QuizApp.war"


                    if errorlevel 1 (

                        echo ERROR: QuizApp.war copy failed.

                        exit /b 1
                    }


                    echo.
                    echo ============================================
                    echo WAR FILES COPIED SUCCESSFULLY
                    echo ============================================


                    echo.
                    echo Current WAR files:

                    dir "%TOMCAT_WEBAPPS%\\*.war"
                '''
            }
        }


        // =====================================================
        // 12. START TOMCAT
        // =====================================================

        stage('Start Tomcat') {

            steps {

                echo '============================================'
                echo 'STARTING TOMCAT'
                echo '============================================'

                bat '''
                    @echo off


                    cd /d "%TOMCAT_HOME%\\bin"


                    set "JENKINS_NODE_COOKIE=dontKillMe"


                    start "Tomcat" /B cmd /c "catalina.bat start"


                    echo.
                    echo Tomcat start command sent.
                '''


                sleep(
                    time: 20,
                    unit: 'SECONDS'
                )
            }
        }


        // =====================================================
        // 13. TOMCAT HEALTH CHECK
        // =====================================================

        stage('Tomcat Health Check') {

            steps {

                echo '============================================'
                echo 'CHECKING TOMCAT'
                echo '============================================'

                timeout(time: 2, unit: 'MINUTES') {

                    powershell '''

                        $ready = $false


                        for ($i = 0; $i -lt 24; $i++) {

                            Write-Host ""
                            Write-Host "Checking Tomcat attempt $($i + 1)..."


                            $connection =
                                Get-NetTCPConnection `
                                    -LocalPort 8084 `
                                    -State Listen `
                                    -ErrorAction SilentlyContinue


                            if ($connection) {

                                Write-Host "Tomcat is listening on port 8084."

                                $ready = $true

                                break
                            }


                            Start-Sleep -Seconds 5
                        }


                        if (-not $ready) {

                            Write-Host ""
                            Write-Host "============================================"
                            Write-Host "TOMCAT FAILED TO START"
                            Write-Host "============================================"


                            Write-Host ""
                            Write-Host "Tomcat logs:"


                            if (Test-Path "$env:TOMCAT_HOME\\logs") {

                                Get-ChildItem `
                                    "$env:TOMCAT_HOME\\logs" |
                                    Sort-Object LastWriteTime -Descending |
                                    Select-Object -First 10
                            }


                            exit 1
                        }


                        Write-Host ""
                        Write-Host "============================================"
                        Write-Host "TOMCAT IS RUNNING"
                        Write-Host "============================================"
                    '''
                }
            }
        }


        // =====================================================
        // 14. VERIFY APPZILLON DEPLOYMENT
        // =====================================================

        stage('Verify Appzillon Deployment') {

            steps {

                echo '============================================'
                echo 'VERIFYING APPZILLON DEPLOYMENT'
                echo '============================================'

                powershell '''

                    Write-Host ""
                    Write-Host "Checking QuizApp WAR..."


                    if (-not (Test-Path "$env:TOMCAT_WEBAPPS\\QuizApp.war")) {

                        Write-Error "QuizApp.war is missing."

                        exit 1
                    }


                    Write-Host "QuizApp.war -> OK"


                    Write-Host ""
                    Write-Host "Checking AppzillonServer WAR..."


                    if (-not (Test-Path "$env:TOMCAT_WEBAPPS\\AppzillonServer.war")) {

                        Write-Error "AppzillonServer.war is missing."

                        exit 1
                    }


                    Write-Host "AppzillonServer.war -> OK"


                    Write-Host ""
                    Write-Host "Waiting for Tomcat deployment..."


                    Start-Sleep -Seconds 20


                    Write-Host ""
                    Write-Host "Checking QuizApp directory..."


                    if (Test-Path "$env:TOMCAT_WEBAPPS\\QuizApp") {

                        Write-Host "QuizApp directory -> OK"

                    } else {

                        Write-Host "WARNING: QuizApp directory not found yet."
                    }


                    Write-Host ""
                    Write-Host "Checking AppzillonServer directory..."


                    if (Test-Path "$env:TOMCAT_WEBAPPS\\AppzillonServer") {

                        Write-Host "AppzillonServer directory -> OK"

                    } else {

                        Write-Host "WARNING: AppzillonServer directory not found yet."
                    }
                '''
            }
        }


        // =====================================================
        // 15. FRONTEND HEALTH CHECK
        // =====================================================

        stage('Frontend Health Check') {

            steps {

                echo '============================================'
                echo 'CHECKING QUIZAPP FRONTEND'
                echo '============================================'

                timeout(time: 2, unit: 'MINUTES') {

                    powershell '''

                        $ready = $false


                        for ($i = 0; $i -lt 24; $i++) {

                            Write-Host ""
                            Write-Host "Checking QuizApp attempt $($i + 1)..."


                            try {

                                $response = Invoke-WebRequest `
                                    -Uri $env:FRONTEND_PAGE_URL `
                                    -UseBasicParsing `
                                    -TimeoutSec 10


                                Write-Host "QuizAp.jsp HTTP Status: $($response.StatusCode)"


                                if ($response.StatusCode -eq 200) {

                                    $ready = $true

                                    break
                                }

                            } catch {

                                Write-Host "QuizApp is not ready yet."
                            }


                            Start-Sleep -Seconds 5
                        }


                        if (-not $ready) {

                            Write-Host ""
                            Write-Host "============================================"
                            Write-Host "QUIZAPP FRONTEND HEALTH CHECK FAILED"
                            Write-Host "============================================"


                            Write-Host ""
                            Write-Host "Expected frontend:"


                            Write-Host $env:FRONTEND_URL


                            Write-Host ""
                            Write-Host "Application page:"


                            Write-Host $env:FRONTEND_PAGE_URL


                            Write-Host ""
                            Write-Host "Check Tomcat logs:"


                            Write-Host "$env:TOMCAT_HOME\\logs"


                            exit 1
                        }


                        Write-Host ""
                        Write-Host "============================================"
                        Write-Host "QUIZAPP FRONTEND IS UP"
                        Write-Host "============================================"


                        Write-Host ""
                        Write-Host "Frontend:"
                        Write-Host $env:FRONTEND_URL


                        Write-Host ""
                        Write-Host "QuizApp page:"
                        Write-Host $env:FRONTEND_PAGE_URL
                    '''
                }
            }
        }


        // =====================================================
        // 16. FINAL SERVICE CHECK
        // =====================================================

        stage('Final Service Check') {

            steps {

                echo '============================================'
                echo 'FINAL SERVICE CHECK'
                echo '============================================'

                powershell '''

                    Write-Host ""
                    Write-Host "Checking Backend port 8020..."


                    $backend =
                        Get-NetTCPConnection `
                            -LocalPort 8020 `
                            -State Listen `
                            -ErrorAction SilentlyContinue


                    if (-not $backend) {

                        Write-Error "Backend is not listening on port 8020."

                        exit 1
                    }


                    Write-Host "Backend :8020 -> OK"


                    Write-Host ""
                    Write-Host "Checking Tomcat port 8084..."


                    $tomcat =
                        Get-NetTCPConnection `
                            -LocalPort 8084 `
                            -State Listen `
                            -ErrorAction SilentlyContinue


                    if (-not $tomcat) {

                        Write-Error "Tomcat is not listening on port 8084."

                        exit 1
                    }


                    Write-Host "Tomcat :8084 -> OK"


                    Write-Host ""
                    Write-Host "Checking backend JAR..."


                    if (-not (Test-Path $env:BACKEND_DEPLOY_JAR)) {

                        Write-Error "Backend JAR missing from JenkinsStorage."

                        exit 1
                    }


                    Write-Host "Backend JAR -> OK"


                    Write-Host ""
                    Write-Host "Checking QuizApp WAR..."


                    if (-not (Test-Path $env:QUIZAPP_WAR)) {

                        Write-Error "QuizApp.war missing."

                        exit 1
                    }


                    Write-Host "QuizApp.war -> OK"


                    Write-Host ""
                    Write-Host "Checking AppzillonServer WAR..."


                    if (-not (Test-Path $env:APPZILLON_SERVER_WAR)) {

                        Write-Error "AppzillonServer.war missing."

                        exit 1
                    }


                    Write-Host "AppzillonServer.war -> OK"


                    Write-Host ""
                    Write-Host "============================================"
                    Write-Host "ALL SERVICES ARE RUNNING"
                    Write-Host "============================================"
                '''
            }
        }
    }


    // =========================================================
    // POST ACTIONS
    // =========================================================

    post {

        success {

            echo '''
============================================
QUIZAPP CI/CD SUCCESSFUL
============================================

Backend:
http://localhost:8020/api/topics

Frontend:
http://localhost:8084/QuizApp/

QuizApp page:
http://localhost:8084/QuizApp/QuizAp.jsp

Backend JAR:
C:/JenkinsStorage/quizapp-1.0.0.jar

QuizApp WAR:
C:/JenkinsStorage/QuizApp.war

AppzillonServer WAR:
C:/JenkinsStorage/AppzillonServer.war

============================================
'''
        }


        failure {

            echo '''
============================================
QUIZAPP CI/CD FAILED
============================================

Check the failed stage above.

Backend log:
C:/JenkinsStorage/backend.log

Backend error log:
C:/JenkinsStorage/backend-error.log

Tomcat logs:
D:/apache-tomcat-9.0.53-windows-x64/apache-tomcat-9.0.53/logs

============================================
'''
        }


        aborted {

            echo '''
============================================
QUIZAPP CI/CD ABORTED
============================================

The Jenkins pipeline was stopped or timed out.

============================================
'''
        }


        always {

            bat '''
                @echo off

                echo.
                echo ==========================================
                echo FINAL STATUS
                echo ==========================================


                echo.
                echo BACKEND PORT 8020:

                powershell -NoProfile -Command "Get-NetTCPConnection -LocalPort 8020 -ErrorAction SilentlyContinue | Format-Table -AutoSize"


                echo.
                echo TOMCAT PORT 8084:

                powershell -NoProfile -Command "Get-NetTCPConnection -LocalPort 8084 -ErrorAction SilentlyContinue | Format-Table -AutoSize"


                echo.
                echo JENKINS STORAGE:

                dir "%STORAGE_DIR%" /A


                echo.
                echo TOMCAT WEBAPPS:

                dir "%TOMCAT_WEBAPPS%" /A
            '''
        }
    }
}