pipeline {

    agent any

    environment {

        // =========================================================
        // JAVA
        // =========================================================

        JAVA_HOME = 'C:/Program Files/Java/jdk-17.0.2'


        // =========================================================
        // JENKINS STORAGE
        // =========================================================

        DEPLOY_DIR = 'C:/JenkinsStorage'

        JAR_NAME = 'quizapp-1.0.0.jar'

        WEB_WAR = 'QuizApp.war'

        SERVER_WAR = 'AppzillonServer.war'


        // =========================================================
        // BACKEND
        // =========================================================

        BACKEND_PORT = '8020'

        BACKEND_URL = 'http://localhost:8020/api/topics'


        // =========================================================
        // TOMCAT
        // =========================================================

        TOMCAT_HOME =
            'D:/apache-tomcat-9.0.53-windows-x64/apache-tomcat-9.0.53'

        TOMCAT_WEBAPPS =
            'D:/apache-tomcat-9.0.53-windows-x64/apache-tomcat-9.0.53/webapps'

        TOMCAT_PORT = '8084'


        // =========================================================
        // QUIZAPP
        // =========================================================

        WEB_CONTEXT = 'QuizApp'

        SERVER_CONTEXT = 'AppzillonServer'

        FRONTEND_URL = 'http://localhost:8084/QuizApp'
    }


    stages {


        // =========================================================
        // 1. CHECKOUT
        // =========================================================

        stage('Checkout') {

            steps {

                echo '=========================================='
                echo 'CHECKOUT'
                echo '=========================================='

                echo 'Source code checked out using Jenkins SCM.'
            }
        }


        // =========================================================
        // 2. BUILD BACKEND
        // =========================================================

        stage('Build Backend') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo BUILDING BACKEND
                    echo ==========================================

                    set "PATH=%JAVA_HOME%\\bin;%PATH%"

                    echo.
                    echo Java version:

                    java -version

                    echo.
                    echo Running Maven build...

                    call mvn clean package -DskipTests

                    if errorlevel 1 (
                        echo.
                        echo ERROR: Maven build failed.
                        exit /b 1
                    )

                    echo.
                    echo Maven build successful.

                    if not exist "%WORKSPACE%\\target\\%JAR_NAME%" (
                        echo.
                        echo ERROR: Backend JAR was not created.
                        echo Expected:
                        echo %WORKSPACE%\\target\\%JAR_NAME%
                        exit /b 1
                    )

                    echo.
                    echo Backend JAR found:

                    dir "%WORKSPACE%\\target\\%JAR_NAME%"
                '''
            }
        }


        // =========================================================
        // 3. RUN TESTS
        // =========================================================

        stage('Run Tests') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo RUNNING TESTS
                    echo ==========================================

                    call mvn test

                    if errorlevel 1 (
                        echo.
                        echo ERROR: Tests failed.
                        exit /b 1
                    )

                    echo.
                    echo Tests completed successfully.
                '''
            }
        }


        // =========================================================
        // 4. VERIFY WAR FILES
        // =========================================================

        stage('Verify Deployment Files') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo VERIFYING DEPLOYMENT FILES
                    echo ==========================================

                    echo.
                    echo Checking:

                    echo %DEPLOY_DIR%\\%WEB_WAR%

                    if not exist "%DEPLOY_DIR%\\%WEB_WAR%" (
                        echo.
                        echo ERROR: QuizApp.war not found.
                        exit /b 1
                    )

                    echo QuizApp.war found.

                    echo.
                    echo Checking:

                    echo %DEPLOY_DIR%\\%SERVER_WAR%

                    if not exist "%DEPLOY_DIR%\\%SERVER_WAR%" (
                        echo.
                        echo ERROR: AppzillonServer.war not found.
                        exit /b 1
                    )

                    echo AppzillonServer.war found.

                    echo.
                    echo Checking backend JAR...

                    if not exist "%WORKSPACE%\\target\\%JAR_NAME%" (
                        echo.
                        echo ERROR: Backend JAR not found.
                        exit /b 1
                    )

                    echo Backend JAR found.

                    echo.
                    echo ==========================================
                    echo ALL DEPLOYMENT FILES ARE AVAILABLE
                    echo ==========================================
                '''
            }
        }


        // =========================================================
        // 5. COPY BACKEND JAR
        // =========================================================

        stage('Copy Backend JAR') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo COPYING BACKEND JAR
                    echo ==========================================

                    copy /Y ^
                    "%WORKSPACE%\\target\\%JAR_NAME%" ^
                    "%DEPLOY_DIR%\\%JAR_NAME%"

                    if errorlevel 1 (
                        echo.
                        echo ERROR: Backend JAR copy failed.
                        exit /b 1
                    )

                    echo.
                    echo Backend JAR copied successfully.

                    dir "%DEPLOY_DIR%\\%JAR_NAME%"
                '''
            }
        }


        // =========================================================
        // 6. STOP OLD BACKEND
        // =========================================================

        stage('Stop Old Backend') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo STOPPING OLD BACKEND
                    echo ==========================================

                    for /f "tokens=5" %%a in (
                        'netstat -ano ^| findstr :%BACKEND_PORT% ^| findstr LISTENING'
                    ) do (

                        echo Found backend PID: %%a

                        taskkill /F /PID %%a >nul 2>&1
                    )

                    echo.
                    echo Waiting for old backend to stop...

                    ping 127.0.0.1 -n 4 >nul

                    echo Backend stop completed.
                '''
            }
        }


        // =========================================================
        // 7. START BACKEND
        // =========================================================

        stage('Start Backend') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo STARTING SPRING BOOT BACKEND
                    echo ==========================================

                    if exist "%DEPLOY_DIR%\\backend.log" (
                        del /F /Q "%DEPLOY_DIR%\\backend.log"
                    )

                    set "PATH=%JAVA_HOME%\\bin;%PATH%"

                    set "JENKINS_NODE_COOKIE=dontKillMe"

                    start "QuizApp-Backend" /B cmd /c ^
                    "set JENKINS_NODE_COOKIE=dontKillMe && "%JAVA_HOME%\\bin\\java.exe" -jar "%DEPLOY_DIR%\\%JAR_NAME%" > "%DEPLOY_DIR%\\backend.log" 2>&1"

                    echo.
                    echo Backend start command executed.

                    echo.
                    echo Waiting for backend startup...

                    ping 127.0.0.1 -n 8 >nul
                '''
            }
        }


        // =========================================================
        // 8. BACKEND HEALTH CHECK
        // =========================================================

        stage('Backend Health Check') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo BACKEND HEALTH CHECK
                    echo ==========================================

                    echo.
                    echo URL:

                    echo %BACKEND_URL%

                    set RETRIES=30

                    :BACKEND_CHECK

                    curl -s -o nul -w "%%{http_code}" ^
                    "%BACKEND_URL%" ^
                    > "%TEMP%\\backend_status.txt"

                    set /p STATUS=<"%TEMP%\\backend_status.txt"

                    echo.
                    echo Backend HTTP Status: %STATUS%

                    if "%STATUS%"=="200" goto BACKEND_SUCCESS

                    set /a RETRIES=%RETRIES%-1

                    if %RETRIES% LEQ 0 goto BACKEND_FAILED

                    echo Backend is not ready.

                    echo Waiting 3 seconds...

                    ping 127.0.0.1 -n 4 >nul

                    goto BACKEND_CHECK


                    :BACKEND_SUCCESS

                    echo.
                    echo ==========================================
                    echo BACKEND IS RUNNING
                    echo ==========================================

                    exit /b 0


                    :BACKEND_FAILED

                    echo.
                    echo ==========================================
                    echo BACKEND FAILED TO START
                    echo ==========================================

                    echo.
                    echo Backend log:

                    if exist "%DEPLOY_DIR%\\backend.log" (
                        powershell -Command "Get-Content '%DEPLOY_DIR%\\backend.log' -Tail 200"
                    )

                    exit /b 1
                '''
            }
        }


        // =========================================================
        // 9. STOP TOMCAT
        // =========================================================

        stage('Stop Tomcat') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo STOPPING TOMCAT
                    echo ==========================================

                    for /f "tokens=5" %%a in (
                        'netstat -ano ^| findstr :%TOMCAT_PORT% ^| findstr LISTENING'
                    ) do (

                        echo Found Tomcat PID: %%a

                        taskkill /F /PID %%a >nul 2>&1
                    )

                    echo.
                    echo Waiting for Tomcat to stop...

                    ping 127.0.0.1 -n 6 >nul

                    echo Tomcat stop completed.
                '''
            }
        }


        // =========================================================
        // 10. CLEAN OLD TOMCAT DEPLOYMENT
        // =========================================================

        stage('Clean Tomcat Deployment') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo CLEANING OLD TOMCAT DEPLOYMENT
                    echo ==========================================

                    echo.
                    echo Removing old QuizApp...

                    if exist "%TOMCAT_WEBAPPS%\\%WEB_CONTEXT%" (
                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\%WEB_CONTEXT%"
                    )

                    if exist "%TOMCAT_WEBAPPS%\\%WEB_WAR%" (
                        del /F /Q "%TOMCAT_WEBAPPS%\\%WEB_WAR%"
                    )


                    echo.
                    echo Removing old AppzillonServer...

                    if exist "%TOMCAT_WEBAPPS%\\%SERVER_CONTEXT%" (
                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\%SERVER_CONTEXT%"
                    )

                    if exist "%TOMCAT_WEBAPPS%\\%SERVER_WAR%" (
                        del /F /Q "%TOMCAT_WEBAPPS%\\%SERVER_WAR%"
                    )


                    echo.
                    echo Removing old Tomcat work directories...

                    if exist "%TOMCAT_HOME%\\work\\Catalina\\localhost\\%WEB_CONTEXT%" (
                        rmdir /S /Q "%TOMCAT_HOME%\\work\\Catalina\\localhost\\%WEB_CONTEXT%"
                    )

                    if exist "%TOMCAT_HOME%\\work\\Catalina\\localhost\\%SERVER_CONTEXT%" (
                        rmdir /S /Q "%TOMCAT_HOME%\\work\\Catalina\\localhost\\%SERVER_CONTEXT%"
                    )


                    echo.
                    echo Old deployment cleaned successfully.
                '''
            }
        }


        // =========================================================
        // 11. COPY QUIZAPP WAR
        // =========================================================

        stage('Copy QuizApp WAR') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo COPYING QUIZAPP WAR
                    echo ==========================================

                    copy /Y ^
                    "%DEPLOY_DIR%\\%WEB_WAR%" ^
                    "%TOMCAT_WEBAPPS%\\%WEB_WAR%"

                    if errorlevel 1 (
                        echo.
                        echo ERROR: QuizApp.war copy failed.
                        exit /b 1
                    )

                    echo.
                    echo QuizApp.war copied successfully.

                    dir "%TOMCAT_WEBAPPS%\\%WEB_WAR%"
                '''
            }
        }


        // =========================================================
        // 12. COPY APPZILLON SERVER WAR
        // =========================================================

        stage('Copy AppzillonServer WAR') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo COPYING APPZILLON SERVER WAR
                    echo ==========================================

                    copy /Y ^
                    "%DEPLOY_DIR%\\%SERVER_WAR%" ^
                    "%TOMCAT_WEBAPPS%\\%SERVER_WAR%"

                    if errorlevel 1 (
                        echo.
                        echo ERROR: AppzillonServer.war copy failed.
                        exit /b 1
                    )

                    echo.
                    echo AppzillonServer.war copied successfully.

                    dir "%TOMCAT_WEBAPPS%\\%SERVER_WAR%"
                '''
            }
        }


        // =========================================================
        // 13. START TOMCAT
        // =========================================================

        stage('Start Tomcat') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo STARTING TOMCAT
                    echo ==========================================

                    set "JAVA_HOME=C:\\Program Files\\Java\\jdk-17.0.2"

                    set "CATALINA_HOME=%TOMCAT_HOME%"

                    set "PATH=%JAVA_HOME%\\bin;%PATH%"

                    set "JENKINS_NODE_COOKIE=dontKillMe"


                    if exist "%TOMCAT_HOME%\\logs\\jenkins-run.log" (
                        del /F /Q "%TOMCAT_HOME%\\logs\\jenkins-run.log"
                    )


                    start "QuizApp-Tomcat" /B cmd /c ^
                    "set JENKINS_NODE_COOKIE=dontKillMe && call "%TOMCAT_HOME%\\bin\\catalina.bat" run > "%TOMCAT_HOME%\\logs\\jenkins-run.log" 2>&1"


                    echo.
                    echo Tomcat start command executed.

                    echo.
                    echo Waiting for Tomcat...

                    ping 127.0.0.1 -n 12 >nul
                '''
            }
        }


        // =========================================================
        // 14. TOMCAT HEALTH CHECK
        // =========================================================

        stage('Tomcat Health Check') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo TOMCAT HEALTH CHECK
                    echo ==========================================

                    set RETRIES=30

                    :TOMCAT_CHECK

                    netstat -ano | findstr :%TOMCAT_PORT% | findstr LISTENING >nul

                    if not errorlevel 1 goto TOMCAT_SUCCESS

                    set /a RETRIES=%RETRIES%-1

                    if %RETRIES% LEQ 0 goto TOMCAT_FAILED

                    echo Tomcat is not ready.

                    echo Waiting 3 seconds...

                    ping 127.0.0.1 -n 4 >nul

                    goto TOMCAT_CHECK


                    :TOMCAT_SUCCESS

                    echo.
                    echo ==========================================
                    echo TOMCAT IS RUNNING
                    echo ==========================================

                    echo.
                    echo Tomcat port:

                    echo %TOMCAT_PORT%

                    exit /b 0


                    :TOMCAT_FAILED

                    echo.
                    echo ==========================================
                    echo TOMCAT FAILED TO START
                    echo ==========================================

                    echo.
                    echo Tomcat log:

                    if exist "%TOMCAT_HOME%\\logs\\jenkins-run.log" (
                        powershell -Command "Get-Content '%TOMCAT_HOME%\\logs\\jenkins-run.log' -Tail 250"
                    )

                    exit /b 1
                '''
            }
        }


        // =========================================================
        // 15. VERIFY QUIZAPP
        // =========================================================

        stage('Verify QuizApp') {

            steps {

                bat '''
                    @echo off

                    echo ==========================================
                    echo VERIFYING QUIZAPP
                    echo ==========================================

                    echo.
                    echo URL:

                    echo %FRONTEND_URL%

                    set RETRIES=30

                    :CHECK_APP

                    curl -s -o nul -w "%%{http_code}" ^
                    "%FRONTEND_URL%" ^
                    > "%TEMP%\\quizapp_status.txt"

                    set /p STATUS=<"%TEMP%\\quizapp_status.txt"

                    echo.
                    echo QuizApp HTTP Status: %STATUS%

                    if "%STATUS%"=="200" goto QUIZAPP_SUCCESS

                    if "%STATUS%"=="302" goto QUIZAPP_SUCCESS

                    set /a RETRIES=%RETRIES%-1

                    if %RETRIES% LEQ 0 goto QUIZAPP_FAILED

                    echo QuizApp is not ready.

                    echo Waiting 5 seconds...

                    ping 127.0.0.1 -n 6 >nul

                    goto CHECK_APP


                    :QUIZAPP_SUCCESS

                    echo.
                    echo ==========================================
                    echo QUIZAPP IS UP
                    echo ==========================================

                    echo.
                    echo Frontend:

                    echo %FRONTEND_URL%

                    exit /b 0


                    :QUIZAPP_FAILED

                    echo.
                    echo ==========================================
                    echo QUIZAPP FAILED TO START
                    echo ==========================================

                    echo.
                    echo URL:

                    echo %FRONTEND_URL%

                    echo.
                    echo Last HTTP Status:

                    echo %STATUS%

                    echo.
                    echo ==========================================
                    echo TOMCAT LOG
                    echo ==========================================

                    if exist "%TOMCAT_HOME%\\logs\\jenkins-run.log" (
                        powershell -Command "Get-Content '%TOMCAT_HOME%\\logs\\jenkins-run.log' -Tail 250"
                    )

                    echo.
                    echo ==========================================
                    echo CATALINA LOG
                    echo ==========================================

                    powershell -Command "Get-ChildItem '%TOMCAT_HOME%\\logs\\catalina*.log' | Sort-Object LastWriteTime -Descending | Select-Object -First 1 | Get-Content -Tail 200"

                    exit /b 1
                '''
            }
        }
    }


    // =============================================================
    // POST ACTIONS
    // =============================================================

    post {

        success {

            echo '''
==========================================
QUIZAPP PIPELINE SUCCESSFUL
==========================================

Backend:
http://localhost:8020/api/topics

Frontend:
http://localhost:8084/QuizApp

QuizApp WAR:
C:\\JenkinsStorage\\QuizApp.war

AppzillonServer WAR:
C:\\JenkinsStorage\\AppzillonServer.war

Backend JAR:
C:\\JenkinsStorage\\quizapp-1.0.0.jar

Tomcat:
D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53

Tomcat Port:
8084

==========================================
'''
        }


        failure {

            echo '''
==========================================
QUIZAPP PIPELINE FAILED
==========================================

Check the failed stage in the Jenkins console.

If QuizApp failed to deploy, check:

D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53\\logs\\jenkins-run.log

==========================================
'''
        }
    }
}