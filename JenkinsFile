/*
 * ============================================================
 * GENERIC BACKEND + FRONTEND DEPLOYMENT PIPELINE
 * ============================================================
 * Works for any project with:
 *   - a Spring Boot (or any java -jar) backend, optional
 *   - one or more Tomcat WAR files, optional
 *
 * Everything project-specific lives in the "parameters" block
 * below. Nothing else in the file should normally need editing.
 *
 * Tomcat install path and the AppzillonServer.war (shared runtime
 * component deployed alongside every app) are FIXED — set once in
 * the "environment" block below, not exposed as build parameters.
 *
 * To reuse for a new project:
 *   1. Copy this file into the new repo as "Jenkinsfile".
 *   2. Update the default values under "parameters" (per-project).
 *   3. Set SKIP_BACKEND / SKIP_FRONTEND / RUN_E2E_TESTS as needed.
 * ============================================================
 */

pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
        timeout(time: 20, unit: 'MINUTES')
    }

    parameters {

        // ---------------- GIT ----------------
        string(name: 'GIT_REPOSITORY', defaultValue: 'https://github.com/your-org/your-repo.git', description: 'Git repository URL')
        string(name: 'GIT_BRANCH', defaultValue: 'main', description: 'Branch to build')

        // ---------------- BACKEND ----------------
        booleanParam(name: 'SKIP_BACKEND', defaultValue: false, description: 'Skip build/deploy/verify of the backend jar')
        string(name: 'BACKEND_DIR', defaultValue: 'C:\\JenkinsStorage\\MyApp', description: 'Directory the backend jar and logs are deployed to')
        string(name: 'BACKEND_BUILD_JAR_GLOB', defaultValue: 'target\\*.jar', description: 'Glob (relative to workspace) matching the jar produced by the build')
        string(name: 'BACKEND_JAR_NAME', defaultValue: 'app.jar', description: 'Filename the deployed jar is renamed to')
        string(name: 'BACKEND_PORT', defaultValue: '8080', description: 'Port the backend listens on')
        string(name: 'BACKEND_HEALTH_PATH', defaultValue: '/actuator/health', description: 'HTTP path used to verify the backend is up; leave blank to skip the HTTP check')
        booleanParam(name: 'SKIP_BACKEND_TESTS', defaultValue: false, description: 'Skip "mvn test" before packaging')

        // ---------------- FRONTEND / TOMCAT ----------------
        // Only the project's OWN war is per-project. AppzillonServer.war
        // is fixed (see "environment" block) and is always deployed
        // alongside it whenever SKIP_FRONTEND is false.
        booleanParam(name: 'SKIP_FRONTEND', defaultValue: false, description: 'Skip deployment of WAR files to Tomcat')
        string(name: 'APP_WAR_SOURCE', defaultValue: 'C:\\JenkinsStorage\\App.war', description: 'Path to this project\'s built WAR file')
        string(name: 'APP_WAR_DEST', defaultValue: 'app.war', description: 'Filename/context this WAR is deployed as in Tomcat webapps, e.g. quizapp.war')
        string(name: 'TOMCAT_PORT', defaultValue: '8080', description: 'Port Tomcat listens on')
        string(name: 'APP_CONTEXT_PATH', defaultValue: 'app', description: 'Context path used to build the frontend verification URL, e.g. "app" -> /app')

        // ---------------- E2E TESTS (optional) ----------------
        // Node/npm-based Playwright project (package.json + tests/), separate
        // from the Java backend. Reuses FRONTEND_URL already built above from
        // TOMCAT_PORT + APP_CONTEXT_PATH as the BASE_URL for the tests — no
        // separate URL parameter needed. Chromium install and how tests run
        // are fixed pipeline behavior; only the toggle and the tests' folder
        // location vary per project.
        booleanParam(name: 'RUN_E2E_TESTS', defaultValue: false, description: 'Run the Playwright end-to-end test stage against FRONTEND_URL, launching Chromium visibly')
        string(name: 'PLAYWRIGHT_DIR', defaultValue: '.', description: 'Path to the Playwright test folder (package.json, package-lock.json, playwright.config.js, tests/), relative to the repo checkout. Playwright ships inside the project repo itself, so this is usually just "." (the repo root) — only change it if a project nests its tests in a subfolder, e.g. "e2e". Required if RUN_E2E_TESTS is true.')
    }

    environment {
        // ---- FIXED INFRA (same for every project — edit here, not per-build) ----
        TOMCAT_HOME          = 'D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53'
        APPZILLON_WAR_SOURCE = 'C:\\JenkinsStorage\\AppzillonServer.war'
        APPZILLON_WAR_DEST   = 'AppzillonServer.war'

        // ---- DERIVED ----
        BACKEND_JAR        = "${params.BACKEND_DIR}\\${params.BACKEND_JAR_NAME}"
        BACKEND_LOG        = "${params.BACKEND_DIR}\\backend.log"
        BACKEND_ERROR_LOG  = "${params.BACKEND_DIR}\\backend-error.log"
        BACKEND_HEALTH_URL = "http://localhost:${params.BACKEND_PORT}${params.BACKEND_HEALTH_PATH}"
        FRONTEND_URL        = "http://localhost:${params.TOMCAT_PORT}/${params.APP_CONTEXT_PATH}"
        TOMCAT_WEBAPPS      = "${env.TOMCAT_HOME}\\webapps"
        // The two WAR files deployed every build: the project's own WAR + the fixed AppzillonServer.war
        WAR_FILES           = "${params.APP_WAR_SOURCE}=${params.APP_WAR_DEST},${env.APPZILLON_WAR_SOURCE}=${env.APPZILLON_WAR_DEST}"
    }

    stages {

        // =====================================================
        // 1. CHECKOUT
        // =====================================================
        stage('Checkout') {
            steps {
                echo '============================================'
                echo 'CHECKOUT FROM GITHUB'
                echo '============================================'

                git(
                    branch: params.GIT_BRANCH,
                    url: params.GIT_REPOSITORY
                )
            }
        }

        // =====================================================
        // 2. CHECK ENVIRONMENT
        // =====================================================
        stage('Check Environment') {
            steps {
                echo '============================================'
                echo 'CHECKING ENVIRONMENT'
                echo '============================================'

                bat '''
                    echo.
                    echo ================= JAVA =================
                    java -version

                    echo.
                    echo ================= MAVEN =================
                    mvn -version
                '''

                script {
                    if (!params.SKIP_BACKEND) {
                        bat """
                            if not exist "${params.BACKEND_DIR}" (
                                mkdir "${params.BACKEND_DIR}"
                            )
                            echo Backend directory: ${params.BACKEND_DIR}
                        """
                    }

                    if (!params.SKIP_FRONTEND) {
                        env.WAR_FILES.split(',').each { pair ->
                            def sourcePath = pair.split('=')[0].trim()
                            bat """
                                if not exist "${sourcePath}" (
                                    echo ERROR: WAR file was not found: ${sourcePath}
                                    exit /b 1
                                )
                                echo Found WAR: ${sourcePath}
                            """
                        }

                        bat """
                            if not exist "${env.TOMCAT_HOME}" (
                                echo ERROR: Tomcat directory was not found: ${env.TOMCAT_HOME}
                                exit /b 1
                            )
                            if not exist "${env.TOMCAT_HOME}\\bin\\startup.bat" (
                                echo ERROR: startup.bat was not found.
                                exit /b 1
                            )
                            if not exist "${env.TOMCAT_HOME}\\bin\\shutdown.bat" (
                                echo ERROR: shutdown.bat was not found.
                                exit /b 1
                            )
                            if not exist "${TOMCAT_WEBAPPS}" (
                                echo ERROR: Tomcat webapps directory was not found: ${TOMCAT_WEBAPPS}
                                exit /b 1
                            )
                            echo Tomcat configuration is valid.
                        """
                    }

                    if (params.RUN_E2E_TESTS) {
                        bat '''
                            echo.
                            echo ================= NODE =================
                            node -v
                            if errorlevel 1 (
                                echo ERROR: Node.js not available
                                exit /b 1
                            )

                            echo.
                            echo ================= NPM ==================
                            call npm -v
                            if errorlevel 1 (
                                echo ERROR: npm not available
                                exit /b 1
                            )
                        '''

                        bat """
                            if not exist "${params.PLAYWRIGHT_DIR}" (
                                echo ERROR: Playwright directory not found: ${params.PLAYWRIGHT_DIR}
                                exit /b 1
                            )
                            if not exist "${params.PLAYWRIGHT_DIR}\\package.json" (
                                echo ERROR: package.json not found in ${params.PLAYWRIGHT_DIR}
                                exit /b 1
                            )
                            if not exist "${params.PLAYWRIGHT_DIR}\\tests" (
                                echo ERROR: tests directory not found in ${params.PLAYWRIGHT_DIR}
                                exit /b 1
                            )
                            echo Playwright project found: ${params.PLAYWRIGHT_DIR}
                        """
                    }
                }
            }
        }

        // =====================================================
        // 3. BUILD BACKEND
        // =====================================================
        stage('Build Backend') {
            when { expression { return !params.SKIP_BACKEND } }
            steps {
                echo '============================================'
                echo 'BUILDING BACKEND'
                echo '============================================'

                script {
                    if (!params.SKIP_BACKEND_TESTS) {
                        bat 'mvn clean test'
                        bat 'mvn package -DskipTests'
                    } else {
                        bat 'mvn clean package -DskipTests'
                    }
                }
            }
        }

        // =====================================================
        // 4. CHECK GENERATED JAR
        // =====================================================
        stage('Check Backend JAR') {
            when { expression { return !params.SKIP_BACKEND } }
            steps {
                echo '============================================'
                echo 'CHECKING GENERATED JAR'
                echo '============================================'

                bat """
                    setlocal enabledelayedexpansion
                    set FOUND=

                    for %%F in (${params.BACKEND_BUILD_JAR_GLOB}) do (
                        set FOUND=%%F
                    )

                    if not defined FOUND (
                        echo ERROR: No jar matching "${params.BACKEND_BUILD_JAR_GLOB}" was generated.
                        echo.
                        echo Contents of target:
                        dir target
                        exit /b 1
                    )

                    echo Backend JAR found: !FOUND!
                    echo !FOUND!> jar_path.txt
                """
            }
        }

        // =====================================================
        // 5. STOP OLD BACKEND
        // =====================================================
        stage('Stop Backend') {
            when { expression { return !params.SKIP_BACKEND } }
            steps {
                echo '============================================'
                echo "STOPPING OLD BACKEND (PORT: ${params.BACKEND_PORT})"
                echo '============================================'

                powershell """
                    \$port = ${params.BACKEND_PORT}

                    Write-Host "Checking port \$port..."

                    \$connections = Get-NetTCPConnection -LocalPort \$port -State Listen -ErrorAction SilentlyContinue

                    if (\$connections) {
                        foreach (\$connection in \$connections) {
                            \$processId = \$connection.OwningProcess
                            Write-Host "Process found on port \$port, PID: \$processId"

                            if (\$processId -gt 0) {
                                Stop-Process -Id \$processId -Force -ErrorAction SilentlyContinue
                                Write-Host "Process stopped."
                            }
                        }
                        Start-Sleep -Seconds 5
                    } else {
                        Write-Host "No process is currently using port \$port."
                    }

                    Write-Host "Backend stop operation completed."
                """
            }
        }

        // =====================================================
        // 6. DEPLOY BACKEND JAR
        // =====================================================
        stage('Deploy Backend JAR') {
            when { expression { return !params.SKIP_BACKEND } }
            steps {
                echo '============================================'
                echo 'DEPLOYING BACKEND JAR'
                echo '============================================'

                bat """
                    setlocal enabledelayedexpansion
                    set /p SRC_JAR=<jar_path.txt

                    if not exist "${params.BACKEND_DIR}" (
                        mkdir "${params.BACKEND_DIR}"
                    )

                    copy /Y "!SRC_JAR!" "${BACKEND_JAR}"

                    if errorlevel 1 (
                        echo ERROR: Failed to copy backend JAR.
                        exit /b 1
                    )

                    if not exist "${BACKEND_JAR}" (
                        echo ERROR: Backend JAR does not exist after copy.
                        exit /b 1
                    )

                    echo Backend JAR deployed successfully.
                    dir "${BACKEND_JAR}"
                """
            }
        }

        // =====================================================
        // 7. START BACKEND
        // =====================================================
        stage('Start Backend') {
            when { expression { return !params.SKIP_BACKEND } }
            steps {
                echo '============================================'
                echo "STARTING BACKEND (PORT: ${params.BACKEND_PORT})"
                echo '============================================'

                powershell """
                    \$jar = "${BACKEND_JAR}"
                    \$log = "${BACKEND_LOG}"
                    \$errorLog = "${BACKEND_ERROR_LOG}"

                    if (-not (Test-Path \$jar)) {
                        Write-Error "Backend JAR not found."
                        exit 1
                    }

                    Write-Host "Starting backend..."

                    \$env:JENKINS_NODE_COOKIE = "dontKillMe"
                    \$env:BUILD_ID = "dontKillMe"

                    \$startCommand = "start `"Backend`" /b java.exe -jar `"\$jar`" 1>>`"\$log`" 2>>`"\$errorLog`""

                    Start-Process -FilePath "cmd.exe" -ArgumentList "/c", \$startCommand -WorkingDirectory "${params.BACKEND_DIR}" -WindowStyle Hidden

                    Write-Host "Backend launch command completed."
                    Start-Sleep -Seconds 2
                """
            }
        }

        // =====================================================
        // 8. WAIT FOR BACKEND PORT
        // =====================================================
        stage('Wait For Backend') {
            when { expression { return !params.SKIP_BACKEND } }
            steps {
                echo '============================================'
                echo "WAITING FOR BACKEND (PORT: ${params.BACKEND_PORT})"
                echo '============================================'

                timeout(time: 90, unit: 'SECONDS') {
                    powershell """
                        \$started = \$false

                        for (\$i = 1; \$i -le 18; \$i++) {
                            Write-Host "Backend check \$i/18..."

                            \$result = Test-NetConnection -ComputerName "localhost" -Port ${params.BACKEND_PORT} -WarningAction SilentlyContinue

                            if (\$result.TcpTestSucceeded) {
                                Write-Host "BACKEND PORT ${params.BACKEND_PORT} IS RUNNING"
                                \$started = \$true
                                break
                            }
                            Start-Sleep -Seconds 5
                        }

                        if (-not \$started) {
                            Write-Host "BACKEND FAILED TO START."

                            if (Test-Path "${BACKEND_LOG}") {
                                Write-Host "========== BACKEND LOG =========="
                                Get-Content "${BACKEND_LOG}" -Tail 80
                            }

                            if (Test-Path "${BACKEND_ERROR_LOG}") {
                                Write-Host "======= BACKEND ERROR LOG ========"
                                Get-Content "${BACKEND_ERROR_LOG}" -Tail 80
                            }

                            exit 1
                        }
                    """
                }
            }
        }

        // =====================================================
        // 9. VERIFY BACKEND HTTP
        // =====================================================
        stage('Verify Backend API') {
            when { expression { return !params.SKIP_BACKEND && params.BACKEND_HEALTH_PATH?.trim() } }
            steps {
                echo '============================================'
                echo 'VERIFYING BACKEND API'
                echo '============================================'

                powershell """
                    \$url = "${BACKEND_HEALTH_URL}"
                    Write-Host "Testing backend API: \$url"

                    try {
                        \$response = Invoke-WebRequest -Uri \$url -Method GET -UseBasicParsing -TimeoutSec 20

                        Write-Host "HTTP Status: \$(\$response.StatusCode)"

                        if (\$response.StatusCode -ge 200 -and \$response.StatusCode -lt 300) {
                            Write-Host "BACKEND API IS WORKING"
                            Write-Host \$response.Content
                        } else {
                            Write-Error "Backend API returned unexpected HTTP status."
                            exit 1
                        }
                    } catch {
                        Write-Host "BACKEND API CHECK FAILED"
                        Write-Error \$_.Exception.Message

                        if (Test-Path "${BACKEND_LOG}") {
                            Write-Host "Backend log:"
                            Get-Content "${BACKEND_LOG}" -Tail 80
                        }
                        exit 1
                    }
                """
            }
        }

        // =====================================================
        // 10. STOP TOMCAT
        // =====================================================
        stage('Stop Tomcat') {
            when { expression { return !params.SKIP_FRONTEND } }
            steps {
                echo '============================================'
                echo "STOPPING TOMCAT (PORT: ${params.TOMCAT_PORT})"
                echo '============================================'

                bat """
                    call "${env.TOMCAT_HOME}\\bin\\shutdown.bat" >nul 2>&1 || echo Tomcat was not running; continuing.
                    echo Waiting for Tomcat to stop...
                    powershell.exe -NoProfile -Command "Start-Sleep -Seconds 10"
                    echo Tomcat stop completed.
                """
            }
        }

        // =====================================================
        // 11. CLEAN OLD FRONTEND DEPLOYMENT
        // =====================================================
        stage('Clean Frontend') {
            when { expression { return !params.SKIP_FRONTEND } }
            steps {
                echo '============================================'
                echo 'CLEANING OLD FRONTEND'
                echo '============================================'

                script {
                    env.WAR_FILES.split(',').each { pair ->
                        def destName = pair.split('=')[1].trim()
                        def baseName = destName.replace('.war', '')

                        bat """
                            if exist "${TOMCAT_WEBAPPS}\\${destName}" (
                                del /F /Q "${TOMCAT_WEBAPPS}\\${destName}"
                            )
                            if exist "${TOMCAT_WEBAPPS}\\${baseName}" (
                                rmdir /S /Q "${TOMCAT_WEBAPPS}\\${baseName}"
                            )
                        """
                    }
                }

                echo 'Old frontend deployment cleaned.'
            }
        }

        // =====================================================
        // 12. DEPLOY FRONTEND WAR(S)
        // =====================================================
        stage('Deploy Frontend') {
            when { expression { return !params.SKIP_FRONTEND } }
            steps {
                echo '============================================'
                echo 'DEPLOYING FRONTEND WAR FILES'
                echo '============================================'

                script {
                    env.WAR_FILES.split(',').each { pair ->
                        def sourcePath = pair.split('=')[0].trim()
                        def destName = pair.split('=')[1].trim()

                        bat """
                            echo Deploying ${destName}...
                            copy /Y "${sourcePath}" "${TOMCAT_WEBAPPS}\\${destName}"
                            if errorlevel 1 (
                                echo ERROR: ${destName} deployment failed.
                                exit /b 1
                            )
                            echo ${destName} deployed successfully.
                        """
                    }
                }

                echo 'FRONTEND WAR DEPLOYMENT COMPLETE'
            }
        }

        // =====================================================
        // 13. START TOMCAT
        // =====================================================
        stage('Start Tomcat') {
            when { expression { return !params.SKIP_FRONTEND } }
            steps {
                echo '============================================'
                echo "STARTING TOMCAT (PORT: ${params.TOMCAT_PORT})"
                echo '============================================'

                bat """
                    set "JENKINS_NODE_COOKIE=dontKillMe"
                    call "${env.TOMCAT_HOME}\\bin\\startup.bat"
                    echo Tomcat startup command completed.
                """
            }
        }

        // =====================================================
        // 14. WAIT FOR TOMCAT
        // =====================================================
        stage('Wait For Tomcat') {
            when { expression { return !params.SKIP_FRONTEND } }
            steps {
                echo '============================================'
                echo "WAITING FOR TOMCAT (PORT: ${params.TOMCAT_PORT})"
                echo '============================================'

                timeout(time: 90, unit: 'SECONDS') {
                    powershell """
                        \$started = \$false

                        for (\$i = 1; \$i -le 18; \$i++) {
                            Write-Host "Tomcat check \$i/18..."

                            \$result = Test-NetConnection -ComputerName "localhost" -Port ${params.TOMCAT_PORT} -WarningAction SilentlyContinue

                            if (\$result.TcpTestSucceeded) {
                                Write-Host "TOMCAT IS RUNNING ON PORT ${params.TOMCAT_PORT}"
                                \$started = \$true
                                break
                            }
                            Start-Sleep -Seconds 5
                        }

                        if (-not \$started) {
                            Write-Host "TOMCAT FAILED TO START."
                            Write-Host "Tomcat logs are located at: ${env.TOMCAT_HOME}\\logs"
                            exit 1
                        }
                    """
                }
            }
        }

        // =====================================================
        // 15. WAIT FOR APP DEPLOYMENT (WAR EXPLOSION)
        // =====================================================
        stage('Wait For App Deployment') {
            when { expression { return !params.SKIP_FRONTEND } }
            steps {
                echo '============================================'
                echo 'WAITING FOR APP DEPLOYMENT'
                echo '============================================'

                bat 'powershell.exe -NoProfile -Command "Start-Sleep -Seconds 20"'
            }
        }

        // =====================================================
        // 16. RUN E2E TESTS (OPTIONAL)
        // =====================================================
        // Node/npm-based Playwright project. It ships inside the same repo
        // as the backend (package.json, playwright.config.js, tests/ all
        // sit at the repo root next to pom.xml), so no separate checkout
        // or external path is needed — PLAYWRIGHT_DIR defaults to ".".
        // FRONTEND_URL (already built from TOMCAT_PORT + APP_CONTEXT_PATH)
        // is passed in as BASE_URL so playwright.config picks it up
        // automatically — no separate URL parameter to fill in. "--headed"
        // makes Chromium launch as a visible window instead of running in
        // the background.
        stage('Run E2E Tests') {
            when { expression { return params.RUN_E2E_TESTS } }
            steps {
                echo '============================================'
                echo 'RUNNING END-TO-END TESTS'
                echo "Frontend URL: ${FRONTEND_URL}"
                echo '============================================'

                // NOTE: npx/npm are .cmd wrappers on Windows. Every one of
                // them MUST be prefixed with "call", otherwise control
                // transfers into that child script and never returns —
                // every command after the first npx/npm call gets silently
                // skipped for the rest of this bat block.
                bat """
                    cd /D "${params.PLAYWRIGHT_DIR}"

                    echo.
                    echo ============================================
                    echo PLAYWRIGHT VERSION
                    echo ============================================
                    call npx playwright --version
                    if errorlevel 1 (
                        echo ERROR: Playwright not available
                        exit /b 1
                    )

                    echo.
                    echo ============================================
                    echo INSTALLING NODE DEPENDENCIES
                    echo ============================================
                    call npm ci
                    if errorlevel 1 (
                        echo ERROR: npm ci failed
                        exit /b 1
                    )

                    echo.
                    echo ============================================
                    echo INSTALLING CHROMIUM
                    echo ============================================
                    call npx playwright install chromium
                    if errorlevel 1 (
                        echo ERROR: Chromium installation failed
                        exit /b 1
                    )

                    if exist "playwright-report" (
                        rmdir /S /Q "playwright-report"
                    )
                    if exist "test-results" (
                        rmdir /S /Q "test-results"
                    )

                    echo.
                    echo ============================================
                    echo STARTING PLAYWRIGHT TESTS
                    echo ============================================
                    set BASE_URL=${FRONTEND_URL}
                    call npx playwright test --headed
                    if errorlevel 1 (
                        echo PLAYWRIGHT TESTS FAILED
                        exit /b 1
                    )

                    echo PLAYWRIGHT TESTS PASSED
                """
            }
        }

        // =====================================================
        // 17. VERIFY FRONTEND FILES
        // =====================================================
        stage('Verify Frontend Deployment') {
            when { expression { return !params.SKIP_FRONTEND } }
            steps {
                echo '============================================'
                echo 'VERIFYING FRONTEND DEPLOYMENT'
                echo '============================================'

                script {
                    env.WAR_FILES.split(',').each { pair ->
                        def destName = pair.split('=')[1].trim()

                        bat """
                            if not exist "${TOMCAT_WEBAPPS}\\${destName}" (
                                echo ERROR: ${destName} was not deployed.
                                exit /b 1
                            )
                            echo ${destName} -> OK
                        """
                    }
                }
            }
        }

        // =====================================================
        // 18. VERIFY FRONTEND HTTP
        // =====================================================
        stage('Verify Frontend HTTP') {
            when { expression { return !params.SKIP_FRONTEND } }
            steps {
                echo '============================================'
                echo 'VERIFYING FRONTEND HTTP'
                echo '============================================'

                powershell """
                    \$url = "${FRONTEND_URL}"
                    Write-Host "Testing frontend: \$url"

                    \$frontendReady = \$false

                    for (\$attempt = 1; \$attempt -le 12; \$attempt++) {
                        Write-Host "Frontend check \$attempt/12..."

                        try {
                            \$response = Invoke-WebRequest -Uri \$url -Method GET -UseBasicParsing -TimeoutSec 10
                            Write-Host "HTTP Status: \$(\$response.StatusCode)"

                            if (\$response.StatusCode -ge 200 -and \$response.StatusCode -lt 400) {
                                \$frontendReady = \$true
                                break
                            }
                        } catch {
                            Write-Host "Frontend is not ready: \$(\$_.Exception.Message)"
                        }

                        Start-Sleep -Seconds 10
                    }

                    if (-not \$frontendReady) {
                        Write-Error "Frontend did not return a successful response within 120 seconds."
                        exit 1
                    }

                    Write-Host "FRONTEND IS WORKING"
                """
            }
        }

        // =====================================================
        // 19. FINAL SERVICE CHECK
        // =====================================================
        stage('Final Service Check') {
            steps {
                echo '============================================'
                echo 'FINAL CI/CD SERVICE CHECK'
                echo '============================================'

                script {
                    if (!params.SKIP_BACKEND) {
                        powershell """
                            \$backend = Test-NetConnection -ComputerName "localhost" -Port ${params.BACKEND_PORT} -WarningAction SilentlyContinue
                            if (-not \$backend.TcpTestSucceeded) {
                                Write-Error "Backend is not running on port ${params.BACKEND_PORT}."
                                exit 1
                            }
                            Write-Host "Backend :${params.BACKEND_PORT} -> RUNNING"
                        """
                    }

                    if (!params.SKIP_FRONTEND) {
                        powershell """
                            \$frontend = Test-NetConnection -ComputerName "localhost" -Port ${params.TOMCAT_PORT} -WarningAction SilentlyContinue
                            if (-not \$frontend.TcpTestSucceeded) {
                                Write-Error "Frontend/Tomcat is not running on port ${params.TOMCAT_PORT}."
                                exit 1
                            }
                            Write-Host "Frontend/Tomcat :${params.TOMCAT_PORT} -> RUNNING"
                        """
                    }
                }

                echo 'CI/CD DEPLOYMENT COMPLETED SUCCESSFULLY'
            }
        }
    }

    // =========================================================
    // POST ACTIONS
    // =========================================================
    post {
        always {
            script {
                if (params.RUN_E2E_TESTS) {
                    echo '============================================'
                    echo 'COLLECTING PLAYWRIGHT TEST RESULTS'
                    echo '============================================'

                    bat """
                        if exist "playwright-report" (
                            rmdir /S /Q "playwright-report"
                        )
                        if exist "${params.PLAYWRIGHT_DIR}\\playwright-report" (
                            xcopy /E /I /Y "${params.PLAYWRIGHT_DIR}\\playwright-report" "playwright-report"
                            echo Playwright report copied.
                        ) else (
                            echo Playwright HTML report not found.
                        )

                        if exist "test-results" (
                            rmdir /S /Q "test-results"
                        )
                        if exist "${params.PLAYWRIGHT_DIR}\\test-results" (
                            xcopy /E /I /Y "${params.PLAYWRIGHT_DIR}\\test-results" "test-results"
                            echo Playwright test artifacts copied.
                        ) else (
                            echo Playwright test-results not found.
                        )
                    """

                    archiveArtifacts(
                        artifacts: 'test-results/**/*',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }

        success {
            echo """
============================================================
              CI/CD DEPLOYMENT SUCCESSFUL
============================================================
Backend URL:  ${env.BACKEND_HEALTH_URL ?: 'N/A'}
Backend Port: ${params.BACKEND_PORT}
Frontend URL: ${env.FRONTEND_URL ?: 'N/A'}
Frontend Port: ${params.TOMCAT_PORT}
Backend Log:   ${env.BACKEND_LOG ?: 'N/A'}
Backend Error: ${env.BACKEND_ERROR_LOG ?: 'N/A'}
============================================================
"""
        }

        failure {
            echo """
============================================================
                 CI/CD DEPLOYMENT FAILED
============================================================
Backend Log:       ${env.BACKEND_LOG ?: 'N/A'}
Backend Error Log: ${env.BACKEND_ERROR_LOG ?: 'N/A'}
Tomcat Logs:       ${env.TOMCAT_HOME}\\logs
============================================================
"""
        }
    }
}
