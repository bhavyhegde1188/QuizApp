pipeline {

    agent any

    environment {

        JAVA_HOME = 'C:/Program Files/Java/jdk-17.0.2'

        DEPLOY_DIR = 'C:/JenkinsStorage'

        JAR_NAME = 'quizapp-1.0.0.jar'

        WEB_WAR = 'QuizApp.war'

        SERVER_WAR = 'AppzillonServer.war'

        BACKEND_PORT = '8020'

        BACKEND_URL = 'http://localhost:8020/api/topics'

        TOMCAT_HOME = 'D:/apache-tomcat-9.0.53-windows-x64/apache-tomcat-9.0.53'

        TOMCAT_WEBAPPS = 'D:/apache-tomcat-9.0.53-windows-x64/apache-tomcat-9.0.53/webapps'

        TOMCAT_PORT = '8084'

        WEB_CONTEXT = 'QuizApp'

        SERVER_CONTEXT = 'AppzillonServer'

        FRONTEND_URL = 'http://localhost:8084/QuizApp/'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'GitHub source code checked out by Jenkins SCM.'
            }
        }

        stage('Build Backend') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo BUILDING SPRING BOOT BACKEND
                    echo ==========================================

                    "%JAVA_HOME%\\bin\\java.exe" -version

                    mvn clean package -DskipTests

                    if errorlevel 1 (
                        echo ERROR: Maven build failed.
                        exit /b 1
                    )

                    if not exist "%WORKSPACE%\\target\\%JAR_NAME%" (
                        echo ERROR: JAR file was not created.
                        exit /b 1
                    )

                    echo Backend JAR created successfully.
                '''
            }
        }

        stage('Run Tests') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo RUNNING TESTS
                    echo ==========================================

                    mvn test

                    if errorlevel 1 (
                        echo ERROR: Maven tests failed.
                        exit /b 1
                    )

                    echo Tests passed successfully.
                '''
            }
        }

        stage('Verify Deployment Files') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo VERIFYING DEPLOYMENT FILES
                    echo ==========================================

                    if not exist "%DEPLOY_DIR%\\%WEB_WAR%" (
                        echo ERROR: Web WAR not found:
                        echo %DEPLOY_DIR%\\%WEB_WAR%
                        exit /b 1
                    )

                    if not exist "%DEPLOY_DIR%\\%SERVER_WAR%" (
                        echo ERROR: Server WAR not found:
                        echo %DEPLOY_DIR%\\%SERVER_WAR%
                        exit /b 1
                    )

                    echo Web WAR:
                    dir "%DEPLOY_DIR%\\%WEB_WAR%"

                    echo.
                    echo Server WAR:
                    dir "%DEPLOY_DIR%\\%SERVER_WAR%"
                '''
            }
        }

        stage('Copy Backend JAR') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo COPYING BACKEND JAR
                    echo ==========================================

                    copy /Y "%WORKSPACE%\\target\\%JAR_NAME%" "%DEPLOY_DIR%\\%JAR_NAME%"

                    if errorlevel 1 (
                        echo ERROR: Failed to copy backend JAR.
                        exit /b 1
                    )

                    echo Backend JAR copied successfully.
                '''
            }
        }

        stage('Deploy Backend') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo DEPLOYING BACKEND
                    echo ==========================================

                    for /f "tokens=5" %%a in ('netstat -ano ^| findstr :%BACKEND_PORT% ^| findstr LISTENING') do (
                        echo Stopping backend PID %%a
                        taskkill /F /PID %%a >nul 2>&1
                    )

                    ping 127.0.0.1 -n 4 >nul

                    if exist "%DEPLOY_DIR%\\backend.log" (
                        del /F /Q "%DEPLOY_DIR%\\backend.log"
                    )

                    start "QuizApp-Backend" /B cmd /c ^
                    "set JENKINS_NODE_COOKIE=dontKillMe&& "%JAVA_HOME%\\bin\\java.exe" -jar "%DEPLOY_DIR%\\%JAR_NAME%" > "%DEPLOY_DIR%\\backend.log" 2>&1"

                    echo Backend start command executed.
                '''
            }
        }

        stage('Backend Health Check') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo BACKEND HEALTH CHECK
                    echo ==========================================

                    set RETRIES=30

                    :BACKEND_CHECK

                    curl -s -o nul -w "%%{http_code}" "%BACKEND_URL%" > "%TEMP%\\backend_status.txt"

                    set /p STATUS=<"%TEMP%\\backend_status.txt"

                    echo Backend HTTP Status: %STATUS%

                    if "%STATUS%"=="200" (
                        echo BACKEND IS RUNNING.
                        exit /b 0
                    )

                    set /a RETRIES-=1

                    if %RETRIES% LEQ 0 (

                        echo ERROR: Backend failed to start.

                        echo ==========================================
                        echo BACKEND LOG
                        echo ==========================================

                        if exist "%DEPLOY_DIR%\\backend.log" (
                            type "%DEPLOY_DIR%\\backend.log"
                        )

                        exit /b 1
                    )

                    ping 127.0.0.1 -n 3 >nul

                    goto BACKEND_CHECK
                '''
            }
        }

        stage('Deploy Appzillon WARs') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo DEPLOYING APPZILLON WAR FILES
                    echo ==========================================

                    if not exist "%DEPLOY_DIR%\\%WEB_WAR%" (
                        echo ERROR: %WEB_WAR% not found.
                        exit /b 1
                    )

                    if not exist "%DEPLOY_DIR%\\%SERVER_WAR%" (
                        echo ERROR: %SERVER_WAR% not found.
                        exit /b 1
                    )

                    echo Stopping Tomcat...

                    call "%TOMCAT_HOME%\\bin\\shutdown.bat"

                    ping 127.0.0.1 -n 8 >nul

                    echo Removing old Web WAR...

                    if exist "%TOMCAT_WEBAPPS%\\%WEB_WAR%" (
                        del /F /Q "%TOMCAT_WEBAPPS%\\%WEB_WAR%"
                    )

                    if exist "%TOMCAT_WEBAPPS%\\%WEB_CONTEXT%" (
                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\%WEB_CONTEXT%"
                    )

                    echo Removing old Server WAR...

                    if exist "%TOMCAT_WEBAPPS%\\%SERVER_WAR%" (
                        del /F /Q "%TOMCAT_WEBAPPS%\\%SERVER_WAR%"
                    )

                    if exist "%TOMCAT_WEBAPPS%\\%SERVER_CONTEXT%" (
                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\%SERVER_CONTEXT%"
                    )

                    echo Copying Web WAR...

                    copy /Y "%DEPLOY_DIR%\\%WEB_WAR%" "%TOMCAT_WEBAPPS%\\%WEB_WAR%"

                    if errorlevel 1 (
                        echo ERROR: Web WAR deployment failed.
                        exit /b 1
                    )

                    echo Web WAR deployed successfully.

                    echo Copying Server WAR...

                    copy /Y "%DEPLOY_DIR%\\%SERVER_WAR%" "%TOMCAT_WEBAPPS%\\%SERVER_WAR%"

                    if errorlevel 1 (
                        echo ERROR: Server WAR deployment failed.
                        exit /b 1
                    )

                    echo Server WAR deployed successfully.

                    echo Starting Tomcat...

                    call "%TOMCAT_HOME%\\bin\\startup.bat"

                    echo Tomcat startup command executed.
                '''
            }
        }

        stage('Tomcat Health Check') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo TOMCAT HEALTH CHECK
                    echo ==========================================

                    set RETRIES=30

                    :TOMCAT_CHECK

                    netstat -ano | findstr :%TOMCAT_PORT% | findstr LISTENING

                    if not errorlevel 1 (
                        echo TOMCAT IS RUNNING ON PORT %TOMCAT_PORT%.
                        exit /b 0
                    )

                    set /a RETRIES-=1

                    if %RETRIES% LEQ 0 (
                        echo ERROR: Tomcat did not start.
                        exit /b 1
                    )

                    ping 127.0.0.1 -n 4 >nul

                    goto TOMCAT_CHECK
                '''
            }
        }

        stage('Frontend Health Check') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo APPZILLON FRONTEND HEALTH CHECK
                    echo ==========================================

                    set RETRIES=30

                    :FRONTEND_CHECK

                    curl -s -o nul -w "%%{http_code}" "%FRONTEND_URL%" > "%TEMP%\\frontend_status.txt"

                    set /p STATUS=<"%TEMP%\\frontend_status.txt"

                    echo Frontend HTTP Status: %STATUS%

                    if "%STATUS%"=="200" (
                        echo APPZILLON FRONTEND IS RUNNING.
                        exit /b 0
                    )

                    if "%STATUS%"=="302" (
                        echo APPZILLON FRONTEND IS RUNNING.
                        exit /b 0
                    )

                    if "%STATUS%"=="403" (
                        echo TOMCAT IS RUNNING.
                        echo QuizApp application is deployed.
                        exit /b 0
                    )

                    set /a RETRIES-=1

                    if %RETRIES% LEQ 0 (
                        echo ERROR: Appzillon frontend health check failed.
                        exit /b 1
                    )

                    ping 127.0.0.1 -n 5 >nul

                    goto FRONTEND_CHECK
                '''
            }
        }

        stage('Schedule Shutdown') {
            steps {

                writeFile file: 'shutdown-quizapp.bat', text: """@echo off

echo QuizApp shutdown timer started.

timeout /t 10800 /nobreak >nul

echo Stopping Spring Boot backend...

for /f "tokens=5" %%a in ('netstat -ano ^| findstr :${BACKEND_PORT} ^| findstr LISTENING') do (
    taskkill /F /PID %%a >nul 2>&1
)

echo Stopping Tomcat...

call "${TOMCAT_HOME}\\bin\\shutdown.bat"

echo QuizApp shutdown completed.
"""

                bat '''
                    @echo off

                    copy /Y "%WORKSPACE%\\shutdown-quizapp.bat" "%DEPLOY_DIR%\\shutdown-quizapp.bat"

                    if errorlevel 1 (
                        echo ERROR: Failed to create shutdown script.
                        exit /b 1
                    )

                    start "QuizApp-Shutdown" /MIN cmd /c call "%DEPLOY_DIR%\\shutdown-quizapp.bat"

                    echo 3 HOUR SHUTDOWN TIMER STARTED.
                '''
            }
        }
    }

    post {

        success {
            echo '''
==========================================
QUIZAPP CI/CD SUCCESSFUL
==========================================

Backend:
http://localhost:8020

Appzillon Web:
http://localhost:8084/QuizApp/

Backend JAR:
C:\\JenkinsStorage\\quizapp-1.0.0.jar

Appzillon Web WAR:
C:\\JenkinsStorage\\QuizApp.war

Appzillon Server WAR:
C:\\JenkinsStorage\\AppzillonServer.war

Backend Log:
C:\\JenkinsStorage\\backend.log

Application shutdown:
After 3 hours

==========================================
'''
        }

        failure {
            echo '''
==========================================
QUIZAPP CI/CD FAILED
==========================================

Check the Jenkins Console Output
and identify the failed stage.

==========================================
'''
        }
    }
}