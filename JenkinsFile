pipeline {

    agent any

    environment {
        TOMCAT_HOME = 'D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53'
        TOMCAT_BIN = 'D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53\\bin'
        TOMCAT_WEBAPPS = 'D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53\\webapps'

        STORAGE = 'C:\\JenkinsStorage'

        QUIZAPP_WAR = 'C:\\JenkinsStorage\\QuizApp.war'
        APPZILLON_WAR = 'C:\\JenkinsStorage\\AppzillonServer.war'

        BACKEND_URL = 'http://localhost:8020/api/topics'
        FRONTEND_URL = 'http://localhost:8084/QuizApp'
    }

    stages {

        stage('Check WAR Files') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo CHECKING WAR FILES
                    echo ==========================================

                    if not exist "%QUIZAPP_WAR%" (
                        echo ERROR: QuizApp.war not found
                        exit /b 1
                    )

                    if not exist "%APPZILLON_WAR%" (
                        echo ERROR: AppzillonServer.war not found
                        exit /b 1
                    )

                    echo QuizApp.war found:
                    dir "%QUIZAPP_WAR%"

                    echo.
                    echo AppzillonServer.war found:
                    dir "%APPZILLON_WAR%"
                '''
            }
        }

        stage('Stop Tomcat') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo STOPPING TOMCAT
                    echo ==========================================

                    if exist "%TOMCAT_BIN%\\shutdown.bat" (
                        call "%TOMCAT_BIN%\\shutdown.bat"
                    )

                    timeout /t 5 /nobreak >nul

                    echo Checking port 8084...

                    netstat -ano | findstr :8084

                    echo Stop stage completed.
                '''
            }
        }

        stage('Clean Old Deployment') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo CLEANING OLD DEPLOYMENT
                    echo ==========================================

                    if exist "%TOMCAT_WEBAPPS%\\QuizApp.war" (
                        del /F /Q "%TOMCAT_WEBAPPS%\\QuizApp.war"
                    )

                    if exist "%TOMCAT_WEBAPPS%\\QuizApp" (
                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\QuizApp"
                    )

                    if exist "%TOMCAT_WEBAPPS%\\AppzillonServer.war" (
                        del /F /Q "%TOMCAT_WEBAPPS%\\AppzillonServer.war"
                    )

                    if exist "%TOMCAT_WEBAPPS%\\AppzillonServer" (
                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\AppzillonServer"
                    )

                    echo Old deployment removed.
                '''
            }
        }

        stage('Copy WAR Files') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo COPYING WAR FILES
                    echo ==========================================

                    copy /Y "%QUIZAPP_WAR%" "%TOMCAT_WEBAPPS%\\QuizApp.war"

                    if errorlevel 1 (
                        echo ERROR: Failed to copy QuizApp.war
                        exit /b 1
                    )

                    copy /Y "%APPZILLON_WAR%" "%TOMCAT_WEBAPPS%\\AppzillonServer.war"

                    if errorlevel 1 (
                        echo ERROR: Failed to copy AppzillonServer.war
                        exit /b 1
                    )

                    echo.
                    echo Files copied successfully.

                    echo.
                    echo Current webapps:
                    dir "%TOMCAT_WEBAPPS%" /A
                '''
            }
        }

        stage('Start Tomcat') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo STARTING TOMCAT
                    echo ==========================================

                    call "%TOMCAT_BIN%\\startup.bat"

                    echo.
                    echo Waiting for Tomcat...
                    timeout /t 15 /nobreak

                    echo.
                    echo Checking port 8084...

                    netstat -ano | findstr :8084

                    if errorlevel 1 (
                        echo ERROR: Tomcat is not listening on port 8084
                        exit /b 1
                    )

                    echo Tomcat is listening on port 8084.
                '''
            }
        }

        stage('Wait For Deployment') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo WAITING FOR QUIZAPP DEPLOYMENT
                    echo ==========================================

                    timeout /t 20 /nobreak

                    echo.
                    echo Checking QuizApp deployment directory...

                    if exist "%TOMCAT_WEBAPPS%\\QuizApp" (
                        echo QuizApp directory exists.
                    ) else (
                        echo WARNING: QuizApp directory does not exist yet.
                    )

                    echo.
                    echo Checking WAR:

                    if exist "%TOMCAT_WEBAPPS%\\QuizApp.war" (
                        echo QuizApp.war exists.
                    ) else (
                        echo ERROR: QuizApp.war is missing.
                        exit /b 1
                    )
                '''
            }
        }

        stage('Verify Backend') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo VERIFYING BACKEND
                    echo ==========================================

                    powershell -Command "try { $r=Invoke-WebRequest -Uri '%BACKEND_URL%' -UseBasicParsing -TimeoutSec 10; Write-Host 'Backend HTTP Status:' $r.StatusCode } catch { Write-Host 'Backend request failed:' $_.Exception.Message; exit 1 }"
                '''
            }
        }

        stage('Verify Frontend') {
            steps {
                bat '''
                    @echo off

                    echo ==========================================
                    echo VERIFYING QUIZAPP FRONTEND
                    echo ==========================================

                    set RETRIES=12

                    :CHECK_FRONTEND

                    powershell -Command "try { $r=Invoke-WebRequest -Uri '%FRONTEND_URL%' -UseBasicParsing -TimeoutSec 5; Write-Host 'QuizApp HTTP Status:' $r.StatusCode; if ($r.StatusCode -ge 200 -and $r.StatusCode -lt 500) { exit 0 } else { exit 1 } } catch { Write-Host 'QuizApp not ready:' $_.Exception.Message; exit 1 }"

                    if not errorlevel 1 (
                        echo.
                        echo ==========================================
                        echo QUIZAPP IS UP
                        echo ==========================================
                        echo URL: %FRONTEND_URL%
                        exit /b 0
                    )

                    set /A RETRIES-=1

                    if %RETRIES% LEQ 0 (
                        echo.
                        echo ==========================================
                        echo QUIZAPP FAILED TO START
                        echo ==========================================
                        exit /b 1
                    )

                    echo.
                    echo QuizApp not ready. Waiting 5 seconds...
                    timeout /t 5 /nobreak >nul

                    goto CHECK_FRONTEND
                '''
            }
        }

    }

    post {

        success {
            echo '=========================================='
            echo 'PIPELINE SUCCESS'
            echo '=========================================='
            echo 'Backend : http://localhost:8020/api/topics'
            echo 'Frontend: http://localhost:8084/QuizApp'
        }

        failure {
            echo '=========================================='
            echo 'PIPELINE FAILED'
            echo '=========================================='
            echo 'Check Tomcat logs:'
            echo '%TOMCAT_HOME%\\logs'
        }

        always {
            bat '''
                @echo off

                echo.
                echo ==========================================
                echo TOMCAT STATUS
                echo ==========================================

                netstat -ano | findstr :8084

                echo.
                echo ==========================================
                echo WEBAPPS
                echo ==========================================

                dir "%TOMCAT_WEBAPPS%" /A
            '''
        }
    }
}