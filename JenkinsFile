pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
        timeout(time: 20, unit: 'MINUTES')
    }

    environment {

        // =====================================================
        // GITHUB
        // =====================================================

        GIT_URL = 'https://github.com/bhavyhegde1188/QuizApp.git'


        // =====================================================
        // JENKINS STORAGE
        // =====================================================

        DEPLOYMENT_DIR = 'C:\\JenkinsStorage'

        QUIZAPP_WAR = 'C:\\JenkinsStorage\\QuizApp.war'

        APPZILLON_SERVER_WAR =
            'C:\\JenkinsStorage\\AppzillonServer.war'


        // =====================================================
        // BACKEND
        // =====================================================

        BACKEND_PORT = '8020'

        BACKEND_LOG =
            'C:\\JenkinsStorage\\backend.log'

        BACKEND_ERROR_LOG =
            'C:\\JenkinsStorage\\backend-error.log'


        // =====================================================
        // TOMCAT
        // =====================================================

        TOMCAT_HOME =
            'D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53'

        TOMCAT_WEBAPPS =
            'D:\\apache-tomcat-9.0.53-windows-x64\\apache-tomcat-9.0.53\\webapps'

        TOMCAT_PORT = '8084'


        // =====================================================
        // APPLICATION URLS
        // =====================================================

        BACKEND_URL =
            'http://localhost:8020/api/topics'

        FRONTEND_URL =
            'http://localhost:8084/QuizApp/'

        FRONTEND_PAGE_URL =
            'http://localhost:8084/QuizApp/QuizAp.jsp'
    }


    stages {


        // =====================================================
        // 1. CHECKOUT
        // =====================================================

        stage('Checkout') {

            steps {

                echo '============================================'
                echo 'CHECKOUT QUIZAPP'
                echo '============================================'

                git(
                    branch: 'main',
                    url: "${GIT_URL}"
                )
            }
        }


        // =====================================================
        // 2. CHECK ENVIRONMENT
        // =====================================================

        stage('Check Environment') {

            steps {

                echo '============================================'
                echo 'CHECKING ENVIRONMENT'
                echo '============================================'

                bat '''
                    @echo off

                    echo.
                    echo ==================== JAVA ====================

                    java -version

                    if errorlevel 1 (
                        echo ERROR: Java is not available.
                        exit /b 1
                    )


                    echo.
                    echo ==================== MAVEN ====================

                    mvn -version

                    if errorlevel 1 (
                        echo ERROR: Maven is not available in PATH.
                        exit /b 1
                    )


                    echo.
                    echo ==================== TOMCAT ====================

                    if not exist "%TOMCAT_HOME%" (
                        echo ERROR: Tomcat directory not found.
                        echo %TOMCAT_HOME%
                        exit /b 1
                    )

                    echo Tomcat found.


                    echo.
                    echo ==================== TOMCAT WEBAPPS ====================

                    if not exist "%TOMCAT_WEBAPPS%" (
                        echo ERROR: Tomcat webapps directory not found.
                        echo %TOMCAT_WEBAPPS%
                        exit /b 1
                    )

                    echo Tomcat webapps found.


                    echo.
                    echo ==================== QUIZAPP WAR ====================

                    if not exist "%QUIZAPP_WAR%" (
                        echo ERROR: QuizApp.war not found.
                        echo Expected:
                        echo %QUIZAPP_WAR%
                        exit /b 1
                    )

                    echo QuizApp.war found.


                    echo.
                    echo ==================== APPZILLON SERVER WAR ====================

                    if not exist "%APPZILLON_SERVER_WAR%" (
                        echo ERROR: AppzillonServer.war not found.
                        echo Expected:
                        echo %APPZILLON_SERVER_WAR%
                        exit /b 1
                    )

                    echo AppzillonServer.war found.


                    echo.
                    echo ============================================
                    echo ENVIRONMENT CHECK SUCCESSFUL
                    echo ============================================
                '''
            }
        }


        // =====================================================
        // 3. BUILD BACKEND
        // =====================================================

        stage('Build Backend') {

            steps {

                echo '============================================'
                echo 'BUILDING SPRING BOOT BACKEND'
                echo '============================================'

                bat '''
                    @echo off

                    mvn clean package -DskipTests

                    if errorlevel 1 (
                        echo.
                        echo ERROR: Backend Maven build failed.
                        exit /b 1
                    )

                    echo.
                    echo Backend build successful.

                    echo.
                    echo Generated JAR:

                    dir "%WORKSPACE%\\target\\*.jar"
                '''
            }
        }


        // =====================================================
        // 4. RUN TESTS
        // =====================================================

        stage('Run Tests') {

            steps {

                echo '============================================'
                echo 'RUNNING BACKEND TESTS'
                echo '============================================'

                bat '''
                    @echo off

                    mvn test

                    if errorlevel 1 (
                        echo.
                        echo ERROR: Backend tests failed.
                        exit /b 1
                    )

                    echo.
                    echo Backend tests passed successfully.
                '''
            }
        }


        // =====================================================
        // 5. VERIFY BACKEND JAR
        // =====================================================

        stage('Verify Backend JAR') {

            steps {

                echo '============================================'
                echo 'VERIFYING BACKEND JAR'
                echo '============================================'

                bat '''
                    @echo off

                    if not exist "%WORKSPACE%\\target\\*.jar" (
                        echo ERROR: Backend JAR was not generated.
                        exit /b 1
                    )

                    echo.
                    echo Backend JAR generated successfully.

                    dir "%WORKSPACE%\\target\\*.jar"
                '''
            }
        }


        // =====================================================
        // 6. STOP OLD BACKEND
        // =====================================================

        stage('Stop Backend') {

            steps {

                echo '============================================'
                echo 'STOPPING OLD BACKEND'
                echo '============================================'

                powershell '''

                    $connections = Get-NetTCPConnection `
                        -LocalPort 8020 `
                        -State Listen `
                        -ErrorAction SilentlyContinue

                    if ($connections) {

                        foreach ($connection in $connections) {

                            $processId = $connection.OwningProcess

                            Write-Host "Stopping backend PID: $processId"

                            Stop-Process `
                                -Id $processId `
                                -Force `
                                -ErrorAction SilentlyContinue
                        }

                    } else {

                        Write-Host "Backend is not currently running."
                    }

                    Start-Sleep -Seconds 3
                '''
            }
        }


        // =====================================================
        // 7. START BACKEND
        // =====================================================

        stage('Start Backend') {

            steps {

                echo '============================================'
                echo 'STARTING BACKEND ON PORT 8020'
                echo '============================================'

                powershell '''

                    $jar = Get-ChildItem `
                        "$env:WORKSPACE\\target\\*.jar" |
                        Where-Object {
                            $_.Name -notlike "*-plain.jar"
                        } |
                        Select-Object -First 1


                    if (-not $jar) {

                        Write-Error "Backend JAR not found."

                        exit 1
                    }


                    Write-Host ""
                    Write-Host "Backend JAR:"
                    Write-Host $jar.FullName


                    if (Test-Path "C:\\JenkinsStorage\\backend.log") {

                        Remove-Item `
                            "C:\\JenkinsStorage\\backend.log" `
                            -Force `
                            -ErrorAction SilentlyContinue
                    }


                    if (Test-Path "C:\\JenkinsStorage\\backend-error.log") {

                        Remove-Item `
                            "C:\\JenkinsStorage\\backend-error.log" `
                            -Force `
                            -ErrorAction SilentlyContinue
                    }


                    $process = Start-Process `
                        -FilePath "java" `
                        -ArgumentList "-jar", $jar.FullName, "--server.port=8020" `
                        -WorkingDirectory $env:WORKSPACE `
                        -RedirectStandardOutput "C:\\JenkinsStorage\\backend.log" `
                        -RedirectStandardError "C:\\JenkinsStorage\\backend-error.log" `
                        -PassThru


                    Write-Host ""
                    Write-Host "Backend started."
                    Write-Host "PID: $($process.Id)"
                '''
            }
        }


        // =====================================================
        // 8. BACKEND HEALTH CHECK
        // =====================================================

        stage('Backend Health Check') {

            steps {

                echo '============================================'
                echo 'CHECKING BACKEND'
                echo '============================================'

                timeout(time: 90, unit: 'SECONDS') {

                    powershell '''

                        $ready = $false


                        for ($i = 0; $i -lt 18; $i++) {

                            Write-Host ""
                            Write-Host "Checking backend attempt $($i + 1)..."


                            try {

                                $response = Invoke-WebRequest `
                                    -Uri "http://localhost:8020/api/topics" `
                                    -UseBasicParsing `
                                    -TimeoutSec 5


                                Write-Host "HTTP Status: $($response.StatusCode)"


                                if ($response.StatusCode -eq 200) {

                                    $ready = $true

                                    break
                                }

                            } catch {

                                Write-Host "Backend is not ready yet."
                            }


                            Start-Sleep -Seconds 5
                        }


                        if (-not $ready) {

                            Write-Host ""
                            Write-Host "============================================"
                            Write-Host "BACKEND FAILED"
                            Write-Host "============================================"


                            if (Test-Path "C:\\JenkinsStorage\\backend.log") {

                                Write-Host ""
                                Write-Host "BACKEND LOG:"
                                Get-Content `
                                    "C:\\JenkinsStorage\\backend.log"
                            }


                            if (Test-Path "C:\\JenkinsStorage\\backend-error.log") {

                                Write-Host ""
                                Write-Host "BACKEND ERROR LOG:"
                                Get-Content `
                                    "C:\\JenkinsStorage\\backend-error.log"
                            }


                            exit 1
                        }


                        Write-Host ""
                        Write-Host "============================================"
                        Write-Host "BACKEND IS UP"
                        Write-Host "http://localhost:8020/api/topics"
                        Write-Host "============================================"
                    '''
                }
            }
        }


        // =====================================================
        // 9. STOP TOMCAT
        // =====================================================

        stage('Stop Tomcat') {

            steps {

                echo '============================================'
                echo 'STOPPING TOMCAT'
                echo '============================================'

                powershell '''

                    $connections = Get-NetTCPConnection `
                        -LocalPort 8084 `
                        -State Listen `
                        -ErrorAction SilentlyContinue


                    if ($connections) {

                        foreach ($connection in $connections) {

                            $processId = $connection.OwningProcess

                            Write-Host "Stopping Tomcat PID: $processId"

                            Stop-Process `
                                -Id $processId `
                                -Force `
                                -ErrorAction SilentlyContinue
                        }

                    } else {

                        Write-Host "Tomcat is not currently running."
                    }


                    Start-Sleep -Seconds 5
                '''
            }
        }


        // =====================================================
        // 10. CLEAN OLD DEPLOYMENT
        // =====================================================

        stage('Clean Old Deployment') {

            steps {

                echo '============================================'
                echo 'CLEANING OLD DEPLOYMENT'
                echo '============================================'

                bat '''
                    @echo off

                    if exist "%TOMCAT_WEBAPPS%\\QuizApp.war" (
                        del /F /Q "%TOMCAT_WEBAPPS%\\QuizApp.war"
                    )

                    if exist "%TOMCAT_WEBAPPS%\\QuizApp" (
                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\QuizApp"
                    )


                    if exist "%TOMCAT_WEBAPPS%\\AppzillonServer.war" (
                        del /F /Q "%TOMCAT_WEBAPPS%\\AppzillonServer.war"
                    )

                    if exist "%TOMCAT_WEBAPPS%\\AppzillonServer" (
                        rmdir /S /Q "%TOMCAT_WEBAPPS%\\AppzillonServer"
                    )


                    echo.
                    echo Old deployment removed.
                '''
            }
        }


        // =====================================================
        // 11. COPY WAR FILES
        // =====================================================

        stage('Deploy Appzillon WARs') {

            steps {

                echo '============================================'
                echo 'COPYING APPZILLON WAR FILES'
                echo '============================================'

                bat '''
                    @echo off

                    echo.
                    echo Copying AppzillonServer.war...

                    copy /Y ^
                        "%APPZILLON_SERVER_WAR%" ^
                        "%TOMCAT_WEBAPPS%\\AppzillonServer.war"


                    if errorlevel 1 (
                        echo ERROR: AppzillonServer.war copy failed.
                        exit /b 1
                    )


                    echo.
                    echo Copying QuizApp.war...

                    copy /Y ^
                        "%QUIZAPP_WAR%" ^
                        "%TOMCAT_WEBAPPS%\\QuizApp.war"


                    if errorlevel 1 (
                        echo ERROR: QuizApp.war copy failed.
                        exit /b 1
                    )


                    echo.
                    echo ============================================
                    echo WAR FILES COPIED SUCCESSFULLY
                    echo ============================================


                    echo.
                    echo Current WAR files:

                    dir "%TOMCAT_WEBAPPS%\\*.war"
                '''
            }
        }


        // =====================================================
        // 12. START TOMCAT
        // =====================================================

        stage('Start Tomcat') {

            steps {

                echo '============================================'
                echo 'STARTING TOMCAT'
                echo '============================================'

                bat '''
                    @echo off

                    cd /d "%TOMCAT_HOME%\\bin"

                    set "JENKINS_NODE_COOKIE=dontKillMe"

                    start "Tomcat" /B cmd /c "catalina.bat start"

                    echo.
                    echo Tomcat start command sent.
                '''

                sleep(
                    time: 20,
                    unit: 'SECONDS'
                )
            }
        }


        // =====================================================
        // 13. TOMCAT HEALTH CHECK
        // =====================================================

        stage('Tomcat Health Check') {

            steps {

                echo '============================================'
                echo 'CHECKING TOMCAT'
                echo '============================================'

                timeout(time: 90, unit: 'SECONDS') {

                    powershell '''

                        $ready = $false


                        for ($i = 0; $i -lt 18; $i++) {

                            Write-Host ""
                            Write-Host "Checking Tomcat attempt $($i + 1)..."


                            $result = Test-NetConnection `
                                -ComputerName "localhost" `
                                -Port 8084 `
                                -WarningAction SilentlyContinue


                            if ($result.TcpTestSucceeded) {

                                $ready = $true

                                break
                            }


                            Start-Sleep -Seconds 5
                        }


                        if (-not $ready) {

                            Write-Host ""
                            Write-Host "============================================"
                            Write-Host "TOMCAT FAILED TO START"
                            Write-Host "============================================"


                            exit 1
                        }


                        Write-Host ""
                        Write-Host "============================================"
                        Write-Host "TOMCAT IS RUNNING"
                        Write-Host "PORT: 8084"
                        Write-Host "============================================"
                    '''
                }
            }
        }


        // =====================================================
        // 14. VERIFY APPZILLON DEPLOYMENT
        // =====================================================

        stage('Verify Appzillon Deployment') {

            steps {

                echo '============================================'
                echo 'VERIFYING APPZILLON DEPLOYMENT'
                echo '============================================'

                powershell '''

                    Write-Host ""
                    Write-Host "Checking QuizApp WAR..."


                    if (-not (Test-Path "$env:TOMCAT_WEBAPPS\\QuizApp.war")) {

                        Write-Error "QuizApp.war does not exist."

                        exit 1
                    }


                    Write-Host "QuizApp.war -> OK"


                    Write-Host ""
                    Write-Host "Checking AppzillonServer WAR..."


                    if (-not (Test-Path "$env:TOMCAT_WEBAPPS\\AppzillonServer.war")) {

                        Write-Error "AppzillonServer.war does not exist."

                        exit 1
                    }


                    Write-Host "AppzillonServer.war -> OK"


                    Write-Host ""
                    Write-Host "Waiting for WAR extraction..."

                    Start-Sleep -Seconds 20


                    Write-Host ""
                    Write-Host "Checking QuizApp directory..."


                    if (Test-Path "$env:TOMCAT_WEBAPPS\\QuizApp") {

                        Write-Host "QuizApp directory -> OK"

                    } else {

                        Write-Host "WARNING: QuizApp directory not extracted yet."
                    }


                    Write-Host ""
                    Write-Host "Checking AppzillonServer directory..."


                    if (Test-Path "$env:TOMCAT_WEBAPPS\\AppzillonServer") {

                        Write-Host "AppzillonServer directory -> OK"

                    } else {

                        Write-Host "WARNING: AppzillonServer directory not extracted yet."
                    }
                '''
            }
        }


        // =====================================================
        // 15. FRONTEND HEALTH CHECK
        // =====================================================

        stage('Frontend Health Check') {

            steps {

                echo '============================================'
                echo 'CHECKING QUIZAPP FRONTEND'
                echo '============================================'

                timeout(time: 90, unit: 'SECONDS') {

                    powershell '''

                        $ready = $false


                        for ($i = 0; $i -lt 18; $i++) {

                            Write-Host ""
                            Write-Host "Checking QuizApp frontend attempt $($i + 1)..."


                            # -------------------------------------------------
                            # Check the actual JSP in the QuizApp WAR.
                            # The WAR contains QuizAp.jsp.
                            # -------------------------------------------------

                            try {

                                $response = Invoke-WebRequest `
                                    -Uri "http://localhost:8084/QuizApp/QuizAp.jsp" `
                                    -UseBasicParsing `
                                    -TimeoutSec 10


                                Write-Host "QuizAp.jsp HTTP Status: $($response.StatusCode)"


                                if ($response.StatusCode -eq 200) {

                                    $ready = $true

                                    break
                                }

                            } catch {

                                Write-Host "QuizAp.jsp is not ready yet."
                            }


                            Start-Sleep -Seconds 5
                        }


                        if (-not $ready) {

                            Write-Host ""
                            Write-Host "============================================"
                            Write-Host "QUIZAPP FRONTEND CHECK FAILED"
                            Write-Host "============================================"


                            Write-Host ""
                            Write-Host "Trying root URL..."


                            try {

                                $root = Invoke-WebRequest `
                                    -Uri "http://localhost:8084/QuizApp/" `
                                    -UseBasicParsing `
                                    -TimeoutSec 10


                                Write-Host "Root HTTP Status: $($root.StatusCode)"


                                if ($root.StatusCode -eq 200) {

                                    $ready = $true
                                }

                            } catch {

                                Write-Host "Root URL also failed."
                            }
                        }


                        if (-not $ready) {

                            Write-Host ""
                            Write-Host "============================================"
                            Write-Host "FRONTEND IS NOT READY"
                            Write-Host "============================================"


                            Write-Host ""
                            Write-Host "Expected URLs:"


                            Write-Host "http://localhost:8084/QuizApp/"


                            Write-Host "http://localhost:8084/QuizApp/QuizAp.jsp"


                            Write-Host ""
                            Write-Host "Tomcat logs:"


                            Write-Host "$env:TOMCAT_HOME\\logs"


                            exit 1
                        }


                        Write-Host ""
                        Write-Host "============================================"
                        Write-Host "QUIZAPP FRONTEND IS UP"
                        Write-Host "============================================"


                        Write-Host ""
                        Write-Host "Frontend:"
                        Write-Host "http://localhost:8084/QuizApp/"


                        Write-Host ""
                        Write-Host "Application page:"
                        Write-Host "http://localhost:8084/QuizApp/QuizAp.jsp"
                    '''
                }
            }
        }


        // =====================================================
        // 16. FINAL CHECK
        // =====================================================

        stage('Final Service Check') {

            steps {

                echo '============================================'
                echo 'FINAL SERVICE CHECK'
                echo '============================================'

                powershell '''

                    Write-Host ""
                    Write-Host "Checking Backend :8020..."


                    $backend = Test-NetConnection `
                        -ComputerName "localhost" `
                        -Port 8020 `
                        -WarningAction SilentlyContinue


                    if (-not $backend.TcpTestSucceeded) {

                        Write-Error "Backend is not running."

                        exit 1
                    }


                    Write-Host "Backend :8020 -> OK"


                    Write-Host ""
                    Write-Host "Checking Tomcat :8084..."


                    $tomcat = Test-NetConnection `
                        -ComputerName "localhost" `
                        -Port 8084 `
                        -WarningAction SilentlyContinue


                    if (-not $tomcat.TcpTestSucceeded) {

                        Write-Error "Tomcat is not running."

                        exit 1
                    }


                    Write-Host "Tomcat :8084 -> OK"


                    Write-Host ""
                    Write-Host "============================================"
                    Write-Host "ALL SERVICES ARE RUNNING"
                    Write-Host "============================================"


                    Write-Host ""
                    Write-Host "Backend:"
                    Write-Host "http://localhost:8020/api/topics"


                    Write-Host ""
                    Write-Host "Frontend:"
                    Write-Host "http://localhost:8084/QuizApp/"


                    Write-Host ""
                    Write-Host "QuizApp page:"
                    Write-Host "http://localhost:8084/QuizApp/QuizAp.jsp"
                '''
            }
        }
    }


    // =========================================================
    // POST ACTIONS
    // =========================================================

    post {

        success {

            echo '''
============================================
QUIZAPP CI/CD SUCCESSFUL
============================================

Backend:
http://localhost:8020/api/topics

Frontend:
http://localhost:8084/QuizApp/

QuizApp page:
http://localhost:8084/QuizApp/QuizAp.jsp

QuizApp WAR:
C:/JenkinsStorage/QuizApp.war

AppzillonServer WAR:
C:/JenkinsStorage/AppzillonServer.war

Backend JAR:
Generated inside Jenkins workspace
NOT copied to JenkinsStorage.

============================================
'''
        }


        failure {

            echo '''
============================================
QUIZAPP CI/CD FAILED
============================================

Check the failed stage in the Jenkins
Console Output.

Tomcat logs:

D:/apache-tomcat-9.0.53-windows-x64/apache-tomcat-9.0.53/logs

Backend log:

C:/JenkinsStorage/backend.log

Backend error log:

C:/JenkinsStorage/backend-error.log

============================================
'''
        }


        always {

            bat '''
                @echo off

                echo.
                echo ==========================================
                echo FINAL STATUS
                echo ==========================================


                echo.
                echo BACKEND PORT 8020:

                powershell -NoProfile -Command "Get-NetTCPConnection -LocalPort 8020 -ErrorAction SilentlyContinue | Format-Table -AutoSize"


                echo.
                echo TOMCAT PORT 8084:

                powershell -NoProfile -Command "Get-NetTCPConnection -LocalPort 8084 -ErrorAction SilentlyContinue | Format-Table -AutoSize"


                echo.
                echo TOMCAT WEBAPPS:

                dir "%TOMCAT_WEBAPPS%" /A
            '''
        }
    }
}